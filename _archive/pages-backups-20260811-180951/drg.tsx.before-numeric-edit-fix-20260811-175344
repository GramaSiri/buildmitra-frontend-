          {/* DYNAMIC SOIL SBC STRUCTURAL RECOMMENDATION BOARD */}
          {primaryTab === "structural_planning" && structuralSubview === "sbc_recommendation" && (
            <div style={{ marginBottom: "20px", display: "flex", flexDirection: "column", gap: "16px" }}>
              
              {/* SBC STATUS BANNER */}
              <div style={{ background: inputs.sbcKpa >= 250 ? "#f0fdf4" : inputs.sbcKpa >= 180 ? "#f0f9ff" : "#fff7ed", padding: "16px 20px", borderRadius: "12px", border: `1px solid ${inputs.sbcKpa >= 250 ? "#bbf7d0" : inputs.sbcKpa >= 180 ? "#bae6fd" : "#fed7aa"}` }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "6px" }}>
                  <h4 style={{ margin: 0, fontSize: "14px", fontWeight: "bold", color: inputs.sbcKpa >= 250 ? "#166534" : inputs.sbcKpa >= 180 ? "#0369a1" : "#c2410c" }}>
                    🧪 USER SOIL SBC STATUS: {inputs.sbcKpa} kN/m² ({inputs.soilType})
                  </h4>
                  <span style={{ fontSize: "11px", fontWeight: "bold", padding: "4px 10px", borderRadius: "6px", background: "#ffffff", border: "1px solid #cbd5e1", color: "#0f172a" }}>
                    IS 456:2000 Compliant
                  </span>
                </div>
                <p style={{ margin: 0, fontSize: "12px", color: "#334155" }}>
                  Based on your configured <b>{inputs.sbcKpa} kN/m² SBC</b> and <b>G+{Math.max(0, inputs.floors - 1)} ({inputs.floors} Storeys)</b> loading, BuildMitra DRG Engine has formulated the structural foundation, concrete grade, and steel reinforcement schedule below.
                </p>
              </div>

              {/* 4-COLUMN STRUCTURAL SPECIFICATION CARDS */}
              <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))", gap: "14px" }}>
                
                {/* CARD 1: FOUNDATION & FOOTING SPECIFICATION */}
                <div style={{ background: "#f8fafc", padding: "14px", borderRadius: "12px", border: "1px solid #cbd5e1" }}>
                  <h5 style={{ margin: "0 0 8px", fontSize: "12px", color: "#0284c7", fontWeight: "bold" }}>🦶 1. Foundation &amp; Footing Detail</h5>
                  <div style={{ fontSize: "11px", color: "#334155", display: "flex", flexDirection: "column", gap: "4px" }}>
                    <div><b>Foundation Type:</b> {structuralPlanningReport?.foundationRecommendation.foundationType || "Isolated Spread Footings"}</div>
                    <div><b>Footing Size:</b> <b style={{ color: "#0284c7" }}>{structuralPlanningReport?.foundationRecommendation.recommendedFootingSize || "1.50m × 1.50m × 0.50m"}</b></div>
                    <div><b>Embedment Depth (Df):</b> {structuralPlanningReport?.foundationRecommendation.minEmbedmentDepthFt || 5.0} ft (1.50 m)</div>
                    <div><b>Footing Rebar Mesh:</b> <b style={{ color: "#dc2626" }}>#12mm TMT @ 150mm c/c Both Ways</b></div>
                    <div><b>PCC Bed Sub-base:</b> 100mm thk 1:3:6 (M10 grade)</div>
                    <div><b>Footing Clear Cover:</b> 50 mm</div>
                  </div>
                </div>

                {/* CARD 2: COLUMN SPECIFICATION */}
                <div style={{ background: "#f8fafc", padding: "14px", borderRadius: "12px", border: "1px solid #cbd5e1" }}>
                  <h5 style={{ margin: "0 0 8px", fontSize: "12px", color: "#0284c7", fontWeight: "bold" }}>🏛️ 2. Column (C1..C12) Detail</h5>
                  <div style={{ fontSize: "11px", color: "#334155", display: "flex", flexDirection: "column", gap: "4px" }}>
                    <div><b>Column Dimensions:</b> <b style={{ color: "#0f172a" }}>9″ × 15″ (230mm × 380mm)</b></div>
                    <div><b>Main Longitudinal Rebar:</b> <b style={{ color: "#0284c7" }}>6-#16mm + 2-#12mm Fe500D</b></div>
                    <div><b>Lateral Ties / Stirrups:</b> <b style={{ color: "#16a34a" }}>#8mm @ 100/150mm c/c</b></div>
                    <div><b>Anchorage Bend (Ld):</b> Min 300 mm (90° Hook in Footing)</div>
                    <div><b>Column Clear Cover:</b> 40 mm</div>
                    <div><b>Ductile Confinement:</b> Per IS 13920:2016 at joints</div>
                  </div>
                </div>

                {/* CARD 3: PLINTH & FLOOR BEAM SPECIFICATION */}
                <div style={{ background: "#f8fafc", padding: "14px", borderRadius: "12px", border: "1px solid #cbd5e1" }}>
                  <h5 style={{ margin: "0 0 8px", fontSize: "12px", color: "#0284c7", fontWeight: "bold" }}>🧱 3. Beam &amp; Slab Detail</h5>
                  <div style={{ fontSize: "11px", color: "#334155", display: "flex", flexDirection: "column", gap: "4px" }}>
                    <div><b>Plinth Beam (PB1):</b> 9″ × 12″ (4-#12mm Main, #8mm @ 150mm c/c)</div>
                    <div><b>Floor Beam (FB1):</b> 9″ × 15″ (4-#16mm + 2-#12mm Main, #8mm @ 125mm)</div>
                    <div><b>RCC Roof Slab (S1):</b> 5″ (125mm) thk (#10mm @ 150mm c/c Main)</div>
                    <div><b>Slab Distribution Bars:</b> #8mm @ 200mm c/c</div>
                    <div><b>Beam / Slab Clear Cover:</b> Beams = 25mm | Slabs = 15mm</div>
                  </div>
                </div>

                {/* CARD 4: MATERIALS & IS CODE COMPLIANCE */}
                <div style={{ background: "#f8fafc", padding: "14px", borderRadius: "12px", border: "1px solid #cbd5e1" }}>
                  <h5 style={{ margin: "0 0 8px", fontSize: "12px", color: "#0284c7", fontWeight: "bold" }}>📜 4. Materials &amp; IS Codes</h5>
                  <div style={{ fontSize: "11px", color: "#334155", display: "flex", flexDirection: "column", gap: "4px" }}>
                    <div><b>Concrete Grade:</b> <b style={{ color: "#16a34a" }}>{structuralPlanningReport?.materials.concreteGrade || "M25"}</b></div>
                    <div><b>Reinforcement Steel:</b> <b style={{ color: "#16a34a" }}>{structuralPlanningReport?.materials.reinforcementSteelGrade || "Fe500D TMT"}</b></div>
                    <div><b>Code Compliance:</b> IS 456:2000 (Plain &amp; Reinforced Concrete)</div>
                    <div><b>Seismic Compliance:</b> IS 1893:2016 (Zone III Seismic Design)</div>
                    <div><b>Ductility Compliance:</b> IS 13920:2016 (Ductile Detailing)</div>
                  </div>
                </div>

              </div>
            </div>
          )}

          {/* GROUND FLOOR ARCHITECTURAL MODE SELECTOR BANNER */}
          {primaryTab === "ground_floor" && (
            <div style={{ marginBottom: "20px", display: "flex", flexDirection: "column", gap: "14px" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", borderBottom: "2px solid #e2e8f0", paddingBottom: "10px" }}>
                <div>
                  <h3 style={{ margin: 0, fontSize: "16px", color: "#166534", fontWeight: "bold" }}>
                    🏠 GROUND FLOOR ARCHITECTURAL DYNAMIC PLANNING ENGINE
                  </h3>
                  <p style={{ margin: "2px 0 0", fontSize: "12px", color: "#64748b" }}>
                    Select Ground Floor Mode below to generate a unique architectural plan coordinated with Vastu, Vertical Core, &amp; Structure:
                  </p>
                </div>
                <div style={{ fontSize: "11px", background: "#f0fdf4", color: "#166534", padding: "6px 12px", borderRadius: "8px", fontWeight: "bold", border: "1px solid #bbf7d0" }}>
                  Active Mode: <b>{inputs.parkingPreference.toUpperCase()}</b>
                </div>
              </div>

              {/* Mode Selector Buttons */}
              <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
                <button
                  onClick={() => updateInput("parkingPreference", "Full Parking")}
                  style={{
                    padding: "8px 16px",
                    borderRadius: "6px",
                    border: "1px solid #cbd5e1",
                    fontSize: "12px",
                    fontWeight: "bold",
                    background: inputs.parkingPreference === "Full Parking" ? "#0284c7" : "#f8fafc",
                    color: inputs.parkingPreference === "Full Parking" ? "#ffffff" : "#334155",
                    cursor: "pointer",
                  }}
                >
                  🚗 Mode A: Full Parking Mode (100% Stilt)
                </button>

                <button
                  onClick={() => updateInput("parkingPreference", "Half Parking")}
                  style={{
                    padding: "8px 16px",
                    borderRadius: "6px",
                    border: "1px solid #cbd5e1",
                    fontSize: "12px",
                    fontWeight: "bold",
                    background: inputs.parkingPreference === "Half Parking" ? "#16a34a" : "#f8fafc",
                    color: inputs.parkingPreference === "Half Parking" ? "#ffffff" : "#334155",
                    cursor: "pointer",
                  }}
                >
                  🏎️ Mode B: Half Parking + Residential (50/50)
                </button>

                <button
                  onClick={() => updateInput("parkingPreference", "No Parking")}
                  style={{
                    padding: "8px 16px",
                    borderRadius: "6px",
                    border: "1px solid #cbd5e1",
                    fontSize: "12px",
                    fontWeight: "bold",
                    background: inputs.parkingPreference === "No Parking" ? "#0f172a" : "#f8fafc",
                    color: inputs.parkingPreference === "No Parking" ? "#ffffff" : "#334155",
                    cursor: "pointer",
                  }}
                >
                  🏠 Mode C: No Parking — Full Residential
                </button>
              </div>

              {/* RECONCILED GROUND FLOOR AREA STATEMENT CARD */}
              <div style={{ background: "#f8fafc", padding: "14px", borderRadius: "12px", border: "1px solid #cbd5e1", display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: "10px", fontSize: "11px" }}>
                <div><b>Plot Area:</b> {inputs.plotWidth * inputs.plotLength} sq.ft ({inputs.plotWidth}′×{inputs.plotLength}′)</div>
                <div><b>Ground Coverage:</b> {groundFloorReport?.areaSchedule.coveragePercent || 65}% ({groundFloorReport?.areaSchedule.builtUpSqFt || 1100} sq.ft)</div>
                <div><b>Parking Area:</b> <b style={{ color: "#0284c7" }}>{groundFloorReport?.areaSchedule.parkingAreaSqFt || 0} sq.ft</b></div>
                <div><b>Usable Residential Area:</b> <b style={{ color: "#16a34a" }}>{groundFloorReport?.areaSchedule.items[0]?.areaSqFt || 0} sq.ft</b></div>
                <div><b>Setback / Open Area:</b> {phase0Report.gbaSetbacks.totalSetbackAreaSqFt} sq.ft ({phase0Report.gbaSetbacks.totalSetbackPct}%)</div>
                <div><b>Services &amp; Core Area:</b> {groundFloorReport?.areaSchedule.circulationAreaSqFt || 150} sq.ft</div>
              </div>
            </div>
          )}

          <div style={{ fontSize: "14px", fontWeight: "bold", color: "#0284c7", marginBottom: "14px" }}>
            📐 ACTIVE MODULE: {primaryTab.toUpperCase()} ({structuralSubview.toUpperCase()})
          </div>

          <div style={{ width: "100%", minHeight: "600px" }}>
            <ArchitecturalSvgRenderer
              primaryTab={primaryTab}
              activeFloorLevel={activeFloorLevel}
              structuralSubview={structuralSubview === "sbc_recommendation" ? "specimen_detail" : structuralSubview}
              candidate={activeCandidate}
              inputs={inputs}
              buildable={{ x: inputs.setbacks.left, y: inputs.setbacks.front, w: inputs.plotWidth - inputs.setbacks.left - inputs.setbacks.right, h: inputs.plotLength - inputs.setbacks.front - inputs.setbacks.rear }}
              columns={buildingModel.columns}
              areaStatement={buildingModel.areaStatement}
              structuralPlanningReport={structuralPlanningReport}
              groundFloorReport={groundFloorReport}
            />
          </div>
        </div>
      )}

    </div>
  );
}

