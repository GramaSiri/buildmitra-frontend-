* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  background-color: #f0f2f5;
}

/* BUILDMITRA MOBILE COMPACT START */

html,
body,
#__next {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  margin: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

img,
video,
canvas,
svg {
  max-width: 100%;
}

/* Do not alter the working payment popup */
.bm-payment-overlay,
.bm-payment-modal,
.bm-payment-modal *,
.bm-payment-qr {
  box-sizing: border-box;
}

@media screen and (max-width: 767px) {

  html {
    font-size: 14px;
  }

  body {
    width: 100%;
    max-width: 100vw;
    min-width: 0;
    overflow-x: hidden !important;
    font-size: 14px;
    line-height: 1.4;
  }

  #__next,
  main,
  .main,
  .main-content,
  .page,
  .page-content,
  .page-container,
  .content,
  .content-wrapper,
  .dashboard,
  .dashboard-content,
  .container,
  .MuiContainer-root {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 8px !important;
    padding-right: 8px !important;
    overflow-x: hidden !important;
  }

  h1,
  .MuiTypography-h1 {
    font-size: 1.45rem !important;
    line-height: 1.2 !important;
    margin-top: 8px !important;
    margin-bottom: 8px !important;
  }

  h2,
  .MuiTypography-h2 {
    font-size: 1.25rem !important;
    line-height: 1.25 !important;
    margin-top: 8px !important;
    margin-bottom: 8px !important;
  }

  h3,
  .MuiTypography-h3 {
    font-size: 1.08rem !important;
    line-height: 1.3 !important;
    margin-top: 6px !important;
    margin-bottom: 6px !important;
  }

  h4,
  h5,
  h6 {
    font-size: 1rem !important;
    line-height: 1.3 !important;
  }

  p,
  span,
  label,
  .MuiTypography-root,
  .MuiFormLabel-root,
  .MuiInputLabel-root {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  form,
  fieldset,
  .form,
  .form-container,
  .form-section,
  .filter-section,
  .filters,
  .search-section {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }

  input,
  select,
  textarea,
  .MuiInputBase-root,
  .MuiOutlinedInput-root,
  .MuiTextField-root,
  .MuiFormControl-root,
  .MuiSelect-root {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    font-size: 14px !important;
  }

  input,
  select,
  .MuiInputBase-root,
  .MuiOutlinedInput-root {
    min-height: 38px !important;
    height: 40px !important;
  }

  textarea {
    min-height: 76px !important;
    height: auto !important;
  }

  input,
  select,
  textarea {
    padding: 8px 10px !important;
    border-radius: 7px !important;
  }

  .MuiInputBase-input,
  .MuiOutlinedInput-input,
  .MuiSelect-select {
    min-height: 20px !important;
    padding: 9px 10px !important;
    font-size: 14px !important;
  }

  .MuiInputLabel-root {
    font-size: 13px !important;
  }

  button,
  .button,
  .btn,
  .MuiButton-root,
  input[type="button"],
  input[type="submit"] {
    min-height: 38px !important;
    max-width: 100%;
    padding: 8px 12px !important;
    border-radius: 7px !important;
    font-size: 13px !important;
    line-height: 1.2 !important;
    white-space: normal !important;
  }

  .card,
  .result-card,
  .result-box,
  .summary-card,
  .calculator-card,
  .boq-card,
  .marketplace-card,
  .property-card,
  .labour-card,
  .MuiCard-root,
  .MuiPaper-root:not(.bm-payment-modal) {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 6px 0 !important;
    padding: 10px !important;
    border-radius: 10px !important;
    overflow-wrap: anywhere;
  }

  .result,
  .results,
  .calculation-result,
  .calculation-results,
  .output,
  .output-box,
  .estimate-box,
  .total-box,
  .summary-box {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    padding: 10px !important;
    margin: 6px 0 !important;
    font-size: 13px !important;
    overflow-x: auto;
    overflow-wrap: anywhere;
  }

  .grid,
  .form-grid,
  .filter-grid,
  .input-grid,
  .result-grid,
  .card-grid,
  .marketplace-grid,
  .property-grid,
  .dashboard-grid,
  .MuiGrid-container {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    gap: 8px !important;
  }

  .form-grid,
  .input-grid,
  .result-grid,
  .filter-grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .card-grid,
  .marketplace-grid,
  .property-grid,
  .dashboard-grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .MuiGrid-item {
    width: 100% !important;
    max-width: 100% !important;
    flex-basis: 100% !important;
    min-width: 0 !important;
  }

  .actions,
  .button-group,
  .action-buttons,
  .card-actions,
  .MuiCardActions-root,
  .MuiDialogActions-root {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 7px !important;
    width: 100% !important;
    padding: 8px 0 !important;
  }

  .actions > *,
  .button-group > *,
  .action-buttons > *,
  .card-actions > * {
    flex: 1 1 120px;
    min-width: 0;
  }

  table {
    width: 100% !important;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 12px !important;
  }

  .table-responsive,
  .bm-table-responsive,
  .MuiTableContainer-root,
  .table-container {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch;
  }

  th,
  td {
    padding: 6px !important;
    font-size: 12px !important;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .MuiDialog-root .MuiDialog-paper,
  .modal,
  .modal-content,
  .dialog,
  .popup,
  .drawer-content {
    width: calc(100vw - 16px) !important;
    max-width: calc(100vw - 16px) !important;
    max-height: 92vh !important;
    margin: 8px !important;
    padding: 12px !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }

  .MuiDrawer-paper {
    max-width: 86vw !important;
  }

  .marketplace-card img,
  .product-card img,
  .property-card img,
  .labour-card img,
  .card img:not(.bm-payment-qr),
  .MuiCardMedia-root {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: 150px !important;
    object-fit: contain !important;
    margin: 0 auto 8px !important;
  }

  .sidebar,
  aside {
    max-width: 86vw;
  }

  pre,
  code {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .desktop-only {
    display: none !important;
  }
}

@media screen and (min-width: 480px) and (max-width: 767px) {

  .card-grid,
  .marketplace-grid,
  .property-grid,
  .dashboard-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media screen and (max-width: 359px) {

  html,
  body {
    font-size: 13px;
  }

  #__next,
  main,
  .main-content,
  .page-content,
  .container {
    padding-left: 6px !important;
    padding-right: 6px !important;
  }

  button,
  .btn,
  .MuiButton-root {
    padding: 7px 9px !important;
    font-size: 12px !important;
  }

  .card,
  .result-card,
  .result-box,
  .MuiCard-root,
  .MuiPaper-root:not(.bm-payment-modal) {
    padding: 8px !important;
  }
}

/* BUILDMITRA MOBILE COMPACT END */

/* BUILDMITRA COMPACT GRID V2 START */

/*
  UI-only responsive refinement.
  Payment barrier, authentication, calculations and APIs are untouched.
*/

@media screen and (max-width: 767px) {

  /* -------------------------------------------------------
     General mobile spacing
  ------------------------------------------------------- */

  main,
  .main-content,
  .page-content,
  .dashboard-content,
  .content-wrapper,
  .container,
  .MuiContainer-root {
    padding-left: 6px !important;
    padding-right: 6px !important;
  }

  .card,
  .calculator-card,
  .boq-card,
  .result-card,
  .summary-card,
  .marketplace-card,
  .product-card,
  .MuiCard-root,
  .MuiPaper-root:not(.bm-payment-modal) {
    padding: 8px !important;
    margin: 4px 0 !important;
    border-radius: 8px !important;
  }

  /* -------------------------------------------------------
     Calculator / BOQ input fields: two per row
  ------------------------------------------------------- */

  .form-grid,
  .input-grid,
  .calculator-input-grid,
  .calculator-grid,
  .boq-input-grid,
  .parameter-grid,
  .fields-grid,
  .filters-grid,
  .filter-grid,
  form > .grid,
  form .MuiGrid-container {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 6px !important;
    width: 100% !important;
    max-width: 100% !important;
    align-items: start !important;
  }

  .form-grid > *,
  .input-grid > *,
  .calculator-input-grid > *,
  .calculator-grid > *,
  .boq-input-grid > *,
  .parameter-grid > *,
  .fields-grid > *,
  .filters-grid > *,
  .filter-grid > *,
  form > .grid > *,
  form .MuiGrid-container > .MuiGrid-item {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    flex-basis: auto !important;
  }

  /* Keep genuinely long fields full width */
  .full-width,
  .field-full,
  .span-2,
  .MuiGrid-grid-xs-12,
  textarea,
  [data-full-width="true"] {
    grid-column: 1 / -1 !important;
  }

  input,
  select,
  .MuiInputBase-root,
  .MuiOutlinedInput-root,
  .MuiSelect-root {
    min-height: 34px !important;
    height: 36px !important;
    font-size: 12.5px !important;
  }

  .MuiInputBase-input,
  .MuiOutlinedInput-input,
  .MuiSelect-select {
    padding: 7px 8px !important;
    font-size: 12.5px !important;
  }

  label,
  .MuiInputLabel-root,
  .MuiFormLabel-root {
    font-size: 11.5px !important;
    line-height: 1.15 !important;
  }

  /* -------------------------------------------------------
     Result boxes: two per row
  ------------------------------------------------------- */

  .result-grid,
  .results-grid,
  .calculator-results,
  .calculation-results,
  .summary-grid,
  .output-grid,
  .metrics-grid,
  .totals-grid,
  .stats-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 6px !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .result-grid > *,
  .results-grid > *,
  .calculator-results > *,
  .calculation-results > *,
  .summary-grid > *,
  .output-grid > *,
  .metrics-grid > *,
  .totals-grid > *,
  .stats-grid > *,
  .result-box,
  .output-box,
  .summary-box,
  .metric-box,
  .total-box {
    min-width: 0 !important;
    width: 100% !important;
    padding: 7px !important;
    margin: 0 !important;
    border-radius: 7px !important;
    font-size: 11.5px !important;
    line-height: 1.25 !important;
    overflow-wrap: anywhere !important;
  }

  .result-box strong,
  .output-box strong,
  .summary-box strong,
  .metric-box strong,
  .total-box strong {
    display: block;
    font-size: 12px !important;
    line-height: 1.2 !important;
  }

  /* -------------------------------------------------------
     Marketplace: two compact items per row
  ------------------------------------------------------- */

  .marketplace-grid,
  .products-grid,
  .product-grid,
  .listing-grid,
  .marketplace-list,
  .items-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 6px !important;
    width: 100% !important;
    max-width: 100% !important;
    align-items: stretch !important;
  }

  .marketplace-card,
  .product-card,
  .listing-card {
    width: 100% !important;
    min-width: 0 !important;
    padding: 7px !important;
    margin: 0 !important;
    overflow: hidden !important;
  }

  .marketplace-card img,
  .product-card img,
  .listing-card img,
  .marketplace-grid .MuiCardMedia-root,
  .products-grid .MuiCardMedia-root {
    display: block !important;
    width: 100% !important;
    height: 82px !important;
    max-height: 82px !important;
    margin: 0 auto 5px !important;
    padding: 2px !important;
    object-fit: contain !important;
    object-position: center !important;
    background: #ffffff !important;
  }

  .marketplace-card h2,
  .marketplace-card h3,
  .marketplace-card h4,
  .product-card h2,
  .product-card h3,
  .product-card h4,
  .listing-card h3 {
    margin: 3px 0 !important;
    font-size: 12px !important;
    line-height: 1.2 !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .marketplace-card p,
  .marketplace-card span,
  .product-card p,
  .product-card span,
  .listing-card p,
  .listing-card span {
    font-size: 10.5px !important;
    line-height: 1.2 !important;
    margin-top: 2px !important;
    margin-bottom: 2px !important;
    overflow-wrap: anywhere !important;
  }

  .marketplace-card button,
  .product-card button,
  .listing-card button,
  .marketplace-card .MuiButton-root,
  .product-card .MuiButton-root {
    min-height: 30px !important;
    padding: 5px 6px !important;
    font-size: 10.5px !important;
    line-height: 1.1 !important;
    border-radius: 6px !important;
  }

  .marketplace-card .actions,
  .marketplace-card .card-actions,
  .product-card .actions,
  .product-card .card-actions,
  .listing-card .actions {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 4px !important;
    padding: 4px 0 0 !important;
  }

  /* Compact Marketplace search and filters */
  .marketplace-search,
  .marketplace-filters,
  .marketplace-filter-grid,
  .search-filter-section {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 5px !important;
    width: 100% !important;
  }

  .marketplace-search > :first-child,
  .search-full-width {
    grid-column: 1 / -1 !important;
  }

  /* -------------------------------------------------------
     Buttons and headings
  ------------------------------------------------------- */

  button,
  .btn,
  .button,
  .MuiButton-root {
    min-height: 34px !important;
    padding: 6px 9px !important;
    font-size: 11.5px !important;
  }

  h1,
  .MuiTypography-h1 {
    font-size: 1.25rem !important;
  }

  h2,
  .MuiTypography-h2 {
    font-size: 1.1rem !important;
  }

  h3,
  .MuiTypography-h3 {
    font-size: 0.98rem !important;
  }

  /*
    Never compact or alter the working payment barrier.
  */
  .bm-payment-overlay .bm-payment-modal,
  .bm-payment-overlay .bm-payment-modal *,
  .bm-payment-overlay .bm-payment-qr {
    box-sizing: border-box;
  }
}

/* Very small phones: retain two columns but tighten further */
@media screen and (max-width: 340px) {

  .form-grid,
  .input-grid,
  .calculator-input-grid,
  .calculator-grid,
  .boq-input-grid,
  .parameter-grid,
  .fields-grid {
    gap: 4px !important;
  }

  input,
  select,
  .MuiInputBase-root,
  .MuiOutlinedInput-root {
    font-size: 11.5px !important;
  }

  .marketplace-card img,
  .product-card img,
  .listing-card img {
    height: 72px !important;
    max-height: 72px !important;
  }
}

/* Larger phones and tablets: three inputs/results/cards per row */
@media screen and (min-width: 600px) and (max-width: 1023px) {

  .form-grid,
  .input-grid,
  .calculator-input-grid,
  .calculator-grid,
  .boq-input-grid,
  .parameter-grid,
  .fields-grid,
  .result-grid,
  .results-grid,
  .calculator-results,
  .summary-grid,
  .output-grid,
  .marketplace-grid,
  .products-grid,
  .product-grid,
  .listing-grid,
  .items-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }

  .marketplace-card img,
  .product-card img,
  .listing-card img {
    height: 105px !important;
    max-height: 105px !important;
  }
}

/* BUILDMITRA COMPACT GRID V2 END */

