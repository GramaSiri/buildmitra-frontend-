// Returns area per piece in sqft
const getTileAreaSqft = (tileSize: string): number => {
  if (!tileSize || tileSize === 'Slab' || tileSize === 'Cast in situ') return 1.0;
  const match = tileSize.replace('Planks ', '').replace('Tiles ', '').split('x');
  if (match.length === 2) {
    const l = parseFloat(match[0]);
    const w = parseFloat(match[1]);
    if (!isNaN(l) && !isNaN(w) && l > 0 && w > 0) {
      return (l * w) / 144;
    }
  }
  return 1.0;
};

export default function FlooringCalculator() {
  const router = useRouter();
  const { checkAndRun } = usePaymentBarrier();
  const { rates: contextRates, loading } = useRates();

  // Rooms State
  const [rooms, setRooms] = useState<any[]>([
    { id: 1, type: 'Living Room', length: 15, width: 12, nos: 1, deductions: 0, flooringType: 'Vitrified Tiles', tileSize: '24x24', layingMethod: 'Tile adhesive', pattern: 'Straight laying', wastagePct: 5, includeSkirting: true, skirtingHeightIn: 4, doorDeductionFt: 3 },
    { id: 2, type: 'Bed Room', length: 12, width: 10, nos: 4, deductions: 0, flooringType: 'Vitrified Tiles', tileSize: '24x24', layingMethod: 'Tile adhesive', pattern: 'Straight laying', wastagePct: 5, includeSkirting: true, skirtingHeightIn: 4, doorDeductionFt: 3 }
  ]);

  const [editingRoomId, setEditingRoomId] = useState<number | null>(null);

  const [roomInput, setRoomInput] = useState<any>({
    type: 'Living Room',
    length: 12,
    width: 10,
    nos: 1,
    deductions: 0,
    flooringType: 'Vitrified Tiles',
    tileSize: '24x24',
    layingMethod: 'Tile adhesive',
    pattern: 'Straight laying',
    wastagePct: 5,
    includeSkirting: true,
    skirtingHeightIn: 4,
    doorDeductionFt: 3
  });

  // Cladding State
  const [claddings, setCladdings] = useState<any[]>([
    { id: 101, title: 'Feature Wall', length: 10, height: 8, nos: 1, openings: 0, type: 'Cladding Tiles', tileSize: '12x24', layingMethod: 'Tile adhesive', wastagePct: 5, needsScaffolding: false }
  ]);

  const [editingCladdingId, setEditingCladdingId] = useState<number | null>(null);

  const [claddingInput, setCladdingInput] = useState<any>({
    title: 'Feature Wall',
    length: 10,
    height: 8,
    nos: 1,
    openings: 0,
    type: 'Cladding Tiles',
    tileSize: '12x24',
    layingMethod: 'Tile adhesive',
    wastagePct: 5,
    needsScaffolding: false
  });

  // Mortar & Bed Thickness Specs
  const [floorMortarBedIn, setFloorMortarBedIn] = useState(0.75);
  const [graniteMortarBedIn, setGraniteMortarBedIn] = useState(1.25);
  const [skirtingMortarBedIn, setSkirtingMortarBedIn] = useState(0.5);
  const [claddingMortarBedIn, setCladdingMortarBedIn] = useState(0.5);
  const [mortarRatio, setMortarRatio] = useState('1:4');
  const [mortarWastagePct, setMortarWastagePct] = useState(5);

  // Toilet Specific Settings
  const [toiletWallHeight, setToiletWallHeight] = useState(7);
  const [toiletDoorDeductionSqft, setToiletDoorDeductionSqft] = useState(15);
  const [toiletVentDeductionSqft, setToiletVentDeductionSqft] = useState(4);
  const [includeWaterproofing, setIncludeWaterproofing] = useState(true);

  const [results, setResults] = useState<any>(null);
  const [generated, setGenerated] = useState(false);

  // Dynamic Rates from Admin Master Rates approved list
  const vitrifiedRateRes = getMasterRate(["vitrified tiles", "vitrified tile", "vitrified"], 0, ["bm_material_rates"]);
  const ceramicRateRes = getMasterRate(["ceramic tiles", "ceramic tile", "ceramic"], 0, ["bm_material_rates"]);
  const graniteRateRes = getMasterRate(["granite", "granite slab"], 0, ["bm_material_rates"]);
  const marbleRateRes = getMasterRate(["marble", "marble slab"], 0, ["bm_material_rates"]);
  const woodenRateRes = getMasterRate(["wooden flooring", "wooden floor", "laminate flooring"], 0, ["bm_material_rates"]);
  const claddingRateRes = getMasterRate(["cladding tiles", "cladding tile", "wall cladding"], 0, ["bm_material_rates"]);

  const cementRateRes = getMasterRate(["cement", "opc", "ppc"], 0, ["bm_material_rates"]);
  const sandRateRes = getMasterRate(["m sand", "m-sand", "sand", "fine aggregate"], 0, ["bm_material_rates"]);
  const adhesiveRateRes = getMasterRate(["tile adhesive", "adhesive", "tile fixer"], 0, ["bm_material_rates"]);
  const groutRateRes = getMasterRate(["tile grout", "grout", "epoxy grout"], 0, ["bm_material_rates"]);
  const spacerRateRes = getMasterRate(["tile spacers", "spacers"], 0, ["bm_material_rates"]);
  const waterproofingRateRes = getMasterRate(["waterproofing", "waterproof chemical"], 0, ["bm_material_rates"]);

  // Labour Rates
  const tileLabourRes = getMasterRate(["tile laying labour", "tile labour", "flooring labour", "tile fixing"], 0, ["bm_labour_rates", "bm_service_rates"]);
  const graniteLabourRes = getMasterRate(["granite laying labour", "granite labour", "marble laying"], 0, ["bm_labour_rates", "bm_service_rates"]);
  const woodenLabourRes = getMasterRate(["wooden flooring labour", "wooden installation"], 0, ["bm_labour_rates", "bm_service_rates"]);
  const claddingLabourRes = getMasterRate(["wall cladding labour", "cladding labour"], 0, ["bm_labour_rates", "bm_service_rates"]);
  const skirtingLabourRes = getMasterRate(["skirting labour", "skirting fixing"], 0, ["bm_labour_rates", "bm_service_rates"]);

  const getTileMasterRateRes = (type: string) => {
    if (type.includes("Vitrified")) return vitrifiedRateRes;
    if (type.includes("Granite")) return graniteRateRes;
    if (type.includes("Marble")) return marbleRateRes;
    if (type.includes("Wooden") || type.includes("Laminate") || type.includes("Vinyl")) return woodenRateRes;
    if (type.includes("Cladding")) return claddingRateRes;
    return ceramicRateRes;
  };

  const getTileLabourRes = (type: string) => {
    if (type.includes("Granite") || type.includes("Marble")) return graniteLabourRes;
    if (type.includes("Wooden") || type.includes("Laminate") || type.includes("Vinyl")) return woodenLabourRes;
    if (type.includes("Cladding")) return claddingLabourRes;
    return tileLabourRes;
  };

  // Input Validation Warnings
  const getValidationWarnings = () => {
    const warnings: string[] = [];
    if (floorMortarBedIn > 1.25) {
      warnings.push(`⚠️ Mortar Thickness Warning: ${floorMortarBedIn}" floor mortar bed is thicker than standard 0.75"-1.0" tile bed specification.`);
    }
    claddings.forEach(c => {
      if (c.layingMethod.includes("adhesive") && claddingMortarBedIn > 0.35) {
        warnings.push(`⚠️ Wall Cladding Warning: Thin-bed Tile Adhesive is selected for ${c.title}, but mortar bed is set to ${claddingMortarBedIn}". Wall adhesive coverage is 3-6mm.`);
      }
    });
    return warnings;
  };

  // ROOM MANAGERS
  const handleSaveRoom = () => {
    if (roomInput.length <= 0 || roomInput.width <= 0 || roomInput.nos <= 0) return;
    if (editingRoomId !== null) {
      setRooms(rooms.map(r => r.id === editingRoomId ? { ...roomInput, id: editingRoomId } : r));
      setEditingRoomId(null);
    } else {
      setRooms([...rooms, { ...roomInput, id: Date.now() }]);
    }
    setRoomInput({
      type: 'Bed Room',
      length: 12,
      width: 10,
      nos: 1,
      deductions: 0,
      flooringType: 'Vitrified Tiles',
      tileSize: '24x24',
      layingMethod: 'Tile adhesive',
      pattern: 'Straight laying',
      wastagePct: 5,
      includeSkirting: true,
      skirtingHeightIn: 4,
      doorDeductionFt: 3
    });
  };

  const handleEditRoom = (r: any) => {
    setEditingRoomId(r.id);
    setRoomInput({ ...r });
  };

  const handleDeleteRoom = (id: number) => {
    setRooms(rooms.filter(r => r.id !== id));
    if (editingRoomId === id) setEditingRoomId(null);
  };

  // CLADDING MANAGERS
  const handleSaveCladding = () => {
    if (claddingInput.length <= 0 || claddingInput.height <= 0 || claddingInput.nos <= 0) return;
    if (editingCladdingId !== null) {
      setCladdings(claddings.map(c => c.id === editingCladdingId ? { ...claddingInput, id: editingCladdingId } : c));
      setEditingCladdingId(null);
    } else {
      setCladdings([...claddings, { ...claddingInput, id: Date.now() }]);
    }
    setCladdingInput({
      title: 'Feature Wall',
      length: 10,
      height: 8,
      nos: 1,
      openings: 0,
      type: 'Cladding Tiles',
      tileSize: '12x24',
      layingMethod: 'Tile adhesive',
      wastagePct: 5,
      needsScaffolding: false
    });
  };

  const handleEditCladding = (c: any) => {
    setEditingCladdingId(c.id);
    setCladdingInput({ ...c });
  };

  const handleDeleteCladding = (id: number) => {
    setCladdings(claddings.filter(c => c.id !== id));
    if (editingCladdingId === id) setEditingCladdingId(null);
  };

  // CALCULATION ENGINE
  const calculateResults = () => {
    const warnings = getValidationWarnings();

    let roomCalculations: any[] = [];
    let claddingCalculations: any[] = [];
    let toiletCalculations: any[] = [];

    let totalFloorNetArea = 0;
    let totalSkirtingNetArea = 0;
    let totalCladdingNetArea = 0;
    let totalToiletFloorArea = 0;
    let totalToiletWallArea = 0;

    let totalMortarVolumeCft = 0;
    let totalAdhesiveKg = 0;
    let totalGroutKg = 0;
    let totalWaterproofingSqft = 0;

    // 1. ROOM-WISE FLOORING & SKIRTING CALCULATIONS
    rooms.forEach(r => {
      const isToilet = r.type === 'Toilet';
      const grossArea = r.length * r.width * r.nos;
      const netFloorArea = Math.max(0, grossArea - (r.deductions || 0));

      const tileAreaPc = getTileAreaSqft(r.tileSize);
      const exactTilesCount = Math.ceil(netFloorArea / tileAreaPc);
      const wastageFactor = 1 + (Number(r.wastagePct || 5) / 100);
      const finalPurchaseTileCount = Math.ceil(exactTilesCount * wastageFactor);
      const purchaseAreaSqft = finalPurchaseTileCount * tileAreaPc;

      const rateRes = getTileMasterRateRes(r.flooringType);
      const labourRes = getTileLabourRes(r.flooringType);

      const tileCost = rateRes.found && rateRes.rate > 0 ? purchaseAreaSqft * rateRes.rate : null;
      const labourCost = labourRes.found && labourRes.rate > 0 ? netFloorArea * labourRes.rate : null;

      // Skirting
      let skirtingPerimeterFt = 2 * (r.length + r.width) * r.nos;
      let netSkirtingLenFt = Math.max(0, skirtingPerimeterFt - (r.doorDeductionFt || 3) * r.nos);
      let skirtingHeightFt = (r.skirtingHeightIn || 4) / 12;
      let netSkirtingAreaSqft = r.includeSkirting && !isToilet ? netSkirtingLenFt * skirtingHeightFt : 0;
      let skirtingTilesCount = r.includeSkirting && !isToilet ? Math.ceil((netSkirtingLenFt / (tileAreaPc > 0 ? Math.sqrt(tileAreaPc) : 1)) * 1.05) : 0;
      let skirtingCost = r.includeSkirting && !isToilet && rateRes.found && rateRes.rate > 0 ? netSkirtingAreaSqft * rateRes.rate : 0;
      let skirtingLabourCost = r.includeSkirting && !isToilet && skirtingLabourRes.found && skirtingLabourRes.rate > 0 ? netSkirtingLenFt * skirtingLabourRes.rate : 0;

      if (!isToilet) {
        totalFloorNetArea += netFloorArea;
        totalSkirtingNetArea += netSkirtingAreaSqft;
      } else {
        totalToiletFloorArea += netFloorArea;
        const netWallAreaPerToilet = Math.max(0, (2 * (r.length + r.width) * toiletWallHeight) - toiletDoorDeductionSqft - toiletVentDeductionSqft);
        const totalToiletWallNet = netWallAreaPerToilet * r.nos;
        totalToiletWallArea += totalToiletWallNet;

        if (includeWaterproofing) {
          totalWaterproofingSqft += (netFloorArea + totalToiletWallNet);
        }
      }

      // Laying Method Mortar / Adhesive allocation
      const isDryOrWood = r.layingMethod.includes("Dry") || r.layingMethod.includes("underlay") || r.flooringType.includes("Wooden") || r.flooringType.includes("Laminate") || r.flooringType.includes("Vinyl");
      const isAdhesive = r.layingMethod.includes("adhesive");

      if (isAdhesive) {
        totalAdhesiveKg += (netFloorArea + netSkirtingAreaSqft) * 0.45; // ~0.45 kg/sqft for 3mm notch
      } else if (!isDryOrWood) {
        const bedThicknessIn = r.flooringType.includes("Granite") || r.flooringType.includes("Marble") ? graniteMortarBedIn : floorMortarBedIn;
        totalMortarVolumeCft += netFloorArea * (bedThicknessIn / 12);
        if (r.includeSkirting && !isToilet) {
          totalMortarVolumeCft += netSkirtingAreaSqft * (skirtingMortarBedIn / 12);
        }
      }

      totalGroutKg += (netFloorArea + netSkirtingAreaSqft) * 0.04; // 0.04 kg/sqft grout

      roomCalculations.push({
        ...r,
        grossArea,
        netFloorArea,
        tileAreaPc,
        exactTilesCount,
        finalPurchaseTileCount,
        purchaseAreaSqft,
        rateRes,
        labourRes,
        tileCost,
        labourCost,
        netSkirtingLenFt,
        netSkirtingAreaSqft,
        skirtingTilesCount,
        skirtingCost,
        skirtingLabourCost
      });
    });

    // 2. WALL CLADDING CALCULATIONS
    claddings.forEach(c => {
      // Correct Area = Length * Height * Nos - Openings
      const netWallAreaSqft = Math.max(0, (c.length * c.height * c.nos) - (c.openings || 0));
      const tileAreaPc = getTileAreaSqft(c.tileSize);
      const exactTilesCount = Math.ceil(netWallAreaSqft / tileAreaPc);
      const wastageFactor = 1 + (Number(c.wastagePct || 5) / 100);
      const finalPurchaseTileCount = Math.ceil(exactTilesCount * wastageFactor);
      const purchaseAreaSqft = finalPurchaseTileCount * tileAreaPc;

      const rateRes = getTileMasterRateRes(c.type);
      const labourRes = claddingLabourRes.found ? claddingLabourRes : getTileLabourRes(c.type);

      const tileCost = rateRes.found && rateRes.rate > 0 ? purchaseAreaSqft * rateRes.rate : null;
      const labourCost = labourRes.found && labourRes.rate > 0 ? netWallAreaSqft * labourRes.rate : null;

      totalCladdingNetArea += netWallAreaSqft;

      if (c.layingMethod.includes("adhesive")) {
        totalAdhesiveKg += netWallAreaSqft * 0.45;
      } else {
        totalMortarVolumeCft += netWallAreaSqft * (claddingMortarBedIn / 12);
      }
      totalGroutKg += netWallAreaSqft * 0.04;

      claddingCalculations.push({
        ...c,
        netWallAreaSqft,
        tileAreaPc,
        exactTilesCount,
        finalPurchaseTileCount,
        purchaseAreaSqft,
        rateRes,
        labourRes,
        tileCost,
        labourCost
      });
    });

    // 3. MORTAR MIX BREAKDOWN (IS 1237 / CPWD)
    const dryMortarFactor = 1.33;
    const mortarWastageFactor = 1 + (mortarWastagePct / 100);
    const totalDryMortarCft = totalMortarVolumeCft * dryMortarFactor * mortarWastageFactor;

    const [cementPart, sandPart] = mortarRatio.split(':').map(Number);
    const totalParts = cementPart + sandPart;

    const cementVolumeCft = totalParts > 0 ? totalDryMortarCft * (cementPart / totalParts) : 0;
    const cementBags = cementVolumeCft > 0 ? cementVolumeCft / 1.226 : 0;
    const sandVolumeCft = totalParts > 0 ? totalDryMortarCft * (sandPart / totalParts) : 0;

    const adhesiveBags20Kg = Math.ceil(totalAdhesiveKg / 20);
    const groutBags5Kg = Math.ceil(totalGroutKg / 5);

    // 4. COSTS COMPUTATION FROM ADMIN MASTER RATES
    const cementCost = cementBags > 0 && cementRateRes.found && cementRateRes.rate > 0 ? cementBags * cementRateRes.rate : 0;
    const sandCost = sandVolumeCft > 0 && sandRateRes.found && sandRateRes.rate > 0 ? sandVolumeCft * sandRateRes.rate : 0;
    const adhesiveCost = totalAdhesiveKg > 0 && adhesiveRateRes.found && adhesiveRateRes.rate > 0 ? adhesiveBags20Kg * adhesiveRateRes.rate : 0;
    const groutCost = totalGroutKg > 0 && groutRateRes.found && groutRateRes.rate > 0 ? groutBags5Kg * groutRateRes.rate : 0;
    const waterproofingCost = totalWaterproofingSqft > 0 && waterproofingRateRes.found && waterproofingRateRes.rate > 0 ? totalWaterproofingSqft * waterproofingRateRes.rate : 0;

    // Sum Materials
    let tilesMaterialTotal: number | null = 0;
    let allTilesFound = true;

    roomCalculations.forEach(r => {
      if (r.tileCost === null) allTilesFound = false;
      else tilesMaterialTotal = (tilesMaterialTotal || 0) + r.tileCost + (r.skirtingCost || 0);
    });

    claddingCalculations.forEach(c => {
      if (c.tileCost === null) allTilesFound = false;
      else tilesMaterialTotal = (tilesMaterialTotal || 0) + c.tileCost;
    });

