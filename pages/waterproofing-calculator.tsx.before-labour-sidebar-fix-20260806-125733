import React, { useEffect, useMemo, useState } from "react";

const API_BASE =
  process.env.NEXT_PUBLIC_API_URL ||
  process.env.NEXT_PUBLIC_API_BASE ||
  "http://localhost:5000";

type MasterRate = {
  name: string;
  brand: string;
  rate: number;
  unit: string;
};

const locations = [
  "Terrace / Roof",
  "Toilet / Bathroom",
  "Balcony",
  "Sunken Slab",
  "Underground Water Tank",
  "Overhead Water Tank",
  "Basement",
  "Retaining Wall",
  "External Wall",
  "Kitchen / Wet Area",
  "Swimming Pool",
  "Damp Proof Course"
];

const systems = [
  "Conventional Brick Bat Coba",
  "Cinder Filling Waterproof Treatment",
  "Polymer Modified Cementitious Coating",
  "Two Component Cementitious Waterproofing",
  "APP / SBS Bituminous Membrane",
  "Self Adhesive Membrane",
  "PU Liquid Membrane",
  "Acrylic Waterproof Coating",
  "Silicone / Elastomeric Coating",
  "Crystalline Waterproofing",
  "Epoxy Waterproof Coating",
  "Damp Proof Coating"
];

const defaultBrands = [
  "Admin Master / Any Approved Brand",
  "Dr. Fixit",
  "Fosroc",
  "Sika",
  "MYK Arment",
  "Asian Paints SmartCare",
  "Pidilite",
  "CICO",
  "STP",
  "Sunanda",
  "Ardex Endura",
  "Other"
];

const n = (value: unknown) => {
  const number = Number(value);
  return Number.isFinite(number) ? number : 0;
};

const fmt = (value: number, digits = 2) =>
  new Intl.NumberFormat("en-IN", {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  }).format(value || 0);

function normalizeMasterRates(payload: any): MasterRate[] {
  const rows =
    payload?.materials ||
    payload?.data ||
    payload?.items ||
    payload ||
    [];

  if (!Array.isArray(rows)) return [];

  return rows.map((row: any) => ({
    name: String(
      row.itemName ||
      row.product_name ||
      row.productName ||
      row.materialName ||
      row.name ||
      ""
    ).toLowerCase(),

    brand: String(
      row.brand ||
      row.make ||
      row.manufacturer ||
      ""
    ).trim(),

    rate: n(
      row.rate ??
      row.price ??
      row.unitRate ??
      row.materialRate ??
      row.sellingPrice
    ),

    unit: String(row.unit || row.uom || "")
  }));
}

export default function WaterproofingCalculator() {
  const [location, setLocation] =
    useState("Terrace / Roof");

  const [system, setSystem] =
    useState("Polymer Modified Cementitious Coating");

  const [brand, setBrand] =
    useState("Admin Master / Any Approved Brand");

  const [customBrand, setCustomBrand] = useState("");

  const [useDirectArea, setUseDirectArea] = useState(false);
  const [directArea, setDirectArea] = useState(100);
  const [length, setLength] = useState(10);
  const [width, setWidth] = useState(10);
  const [height, setHeight] = useState(0);
  const [numberOfUnits, setNumberOfUnits] = useState(1);
  const [deductionArea, setDeductionArea] = useState(0);
  const [wastage, setWastage] = useState(5);

  const [coats, setCoats] = useState(2);
  const [coverage, setCoverage] = useState(1.5);
  const [treatmentThickness, setTreatmentThickness] =
    useState(75);

  const [rollWidth, setRollWidth] = useState(1);
  const [rollLength, setRollLength] = useState(10);
  const [lapEfficiency, setLapEfficiency] = useState(85);

  const [manualLabourRate, setManualLabourRate] =
    useState(0);

  const [gst, setGst] = useState(18);
  const [masterRates, setMasterRates] =
    useState<MasterRate[]>([]);

  const [rateStatus, setRateStatus] =
    useState("Loading Admin Master rates...");

  useEffect(() => {
    const loadRates = async () => {
      try {
        const response = await fetch(
          `${API_BASE}/api/master/materials`
        );

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const payload = await response.json();
        const rows = normalizeMasterRates(payload);

        setMasterRates(rows);

        setRateStatus(
          rows.length
            ? `${rows.length} Admin Master rates loaded`
            : "No Admin Master rates found"
        );
      } catch {
        setMasterRates([]);
        setRateStatus(
          "Admin Master unavailable — manual labour rate allowed"
        );
      }
    };

    loadRates();
  }, []);

  const availableBrands = useMemo(() => {
    const fromMaster = masterRates
      .map((row) => row.brand)
      .filter(Boolean);

    return Array.from(
      new Set([...defaultBrands, ...fromMaster])
    );
  }, [masterRates]);

  const selectedBrand =
    brand === "Other"
      ? customBrand.trim() || "Other"
      : brand;

  const findRate = (...terms: string[]) => {
    const keywords = terms
      .map((term) => term.toLowerCase().trim())
      .filter(Boolean);

    const brandFilter =
      selectedBrand &&
      selectedBrand !== "Admin Master / Any Approved Brand"
        ? selectedBrand.toLowerCase()
        : "";

    const brandRows = brandFilter
      ? masterRates.filter((row) =>
          row.brand.toLowerCase().includes(brandFilter)
        )
      : masterRates;

    const exact = brandRows.find((row) =>
      keywords.every((keyword) =>
        row.name.includes(keyword)
      )
    );

    if (exact?.rate) return exact.rate;

    const partial = brandRows.find((row) =>
      keywords.some((keyword) =>
        row.name.includes(keyword)
      )
    );

    if (partial?.rate) return partial.rate;

    const fallback = masterRates.find((row) =>
      keywords.some((keyword) =>
        row.name.includes(keyword)
      )
    );

    return fallback?.rate || 0;
  };

  const result = useMemo(() => {
    const unitCount = Math.max(1, n(numberOfUnits));

    let grossArea = useDirectArea
      ? n(directArea)
      : n(length) * n(width);

    const enclosedTreatment =
      /tank|basement|pool/i.test(location) &&
      n(height) > 0 &&
      !useDirectArea;

    if (enclosedTreatment) {
      const floorArea = n(length) * n(width);

      const internalWallArea =
        2 *
        (n(length) + n(width)) *
        n(height);

      grossArea = floorArea + internalWallArea;
    }

    grossArea *= unitCount;

    const netArea = Math.max(
      0,
      grossArea - n(deductionArea)
    );

    const billableArea =
      netArea *
      (1 + Math.max(0, n(wastage)) / 100);

    const systemText = system.toLowerCase();

    const membraneSystem =
      /membrane|app|sbs/.test(systemText);

    const conventionalSystem =
      /brick bat|cinder/.test(systemText);

    const liquidSystem =
      !membraneSystem && !conventionalSystem;

    const primerQty =
      liquidSystem || membraneSystem
        ? billableArea / 8
        : 0;

    const coatingQty = liquidSystem
      ? (
          billableArea *
          Math.max(1, n(coats))
        ) / Math.max(0.01, n(coverage))
      : 0;

    const effectiveRollArea =
      n(rollWidth) *
      n(rollLength) *
      (Math.max(1, n(lapEfficiency)) / 100);

    const membraneRolls = membraneSystem
      ? Math.ceil(
          billableArea /
          Math.max(0.01, effectiveRollArea)
        )
      : 0;

    const fillVolume = conventionalSystem
      ? billableArea *
        (n(treatmentThickness) / 1000)
      : 0;

    const cementKg =
      conventionalSystem ? fillVolume * 360 : 0;

    const cementBags = cementKg / 50;

    const sandM3 =
      conventionalSystem ? fillVolume * 0.75 : 0;

    const brickBatM3 =
      conventionalSystem ? fillVolume * 0.8 : 0;

    const compoundKg =
      conventionalSystem ? cementKg * 0.02 : 0;

    const rows = [
      {
        key: "primer",
        item: "Waterproofing Primer",
        make: selectedBrand,
        quantity: primerQty,
        unit: "L",
        rate: findRate("waterproof", "primer")
      },
      {
        key: "system",
        item: system,
        make: selectedBrand,
        quantity: coatingQty,
        unit: "KG / L",
        rate:
          findRate(
            ...systemText
              .split(" ")
              .filter((word) => word.length > 3)
              .slice(0, 2)
          ) ||
          findRate("waterproof")
      },
      {
        key: "membrane",
        item: system,
        make: selectedBrand,
        quantity: membraneRolls,
        unit: "ROLL",
        rate:
          findRate("membrane") ||
          findRate("app") ||
          findRate("sbs")
      },
      {
        key: "cement",
        item: "Cement",
        make: "As per Admin Master",
        quantity: cementBags,
        unit: "BAG",
        rate: findRate("cement")
      },
      {
        key: "sand",
        item: "Sand",
        make: "Approved Source",
        quantity: sandM3,
        unit: "M³",
        rate: findRate("sand")
      },
      {
        key: "fill",
        item: /cinder/i.test(system)
          ? "Cinder Filling"
          : "Brick Bats",
        make: "Approved Source",
        quantity: brickBatM3,
        unit: "M³",
        rate: /cinder/i.test(system)
          ? findRate("cinder")
          : findRate("brick")
      },
      {
        key: "compound",
        item: "Integral Waterproofing Compound",
        make: selectedBrand,
        quantity: compoundKg,
        unit: "KG",
        rate:
          findRate("waterproof", "compound") ||
          findRate("integral", "compound")
      }
    ].filter((row) => row.quantity > 0.001);

    const adminLabourRate =
      findRate("waterproof", "labour") ||
      findRate("waterproofing", "application") ||
      findRate("application", "labour");

    const appliedLabourRate =
      adminLabourRate || Math.max(0, n(manualLabourRate));

    const materialCost = rows.reduce(
      (total, row) =>
        total + row.quantity * row.rate,
      0
    );

    const labourCost =
      billableArea * appliedLabourRate;

    const subtotal = materialCost + labourCost;

    const gstAmount =
      subtotal *
      (Math.max(0, n(gst)) / 100);

    const grandTotal = subtotal + gstAmount;

    return {
      grossArea,
      netArea,
      billableArea,
      primerQty,
      coatingQty,
      membraneRolls,
      fillVolume,
      cementBags,
      sandM3,
      brickBatM3,
      compoundKg,
      rows,
      adminLabourRate,
      appliedLabourRate,
      materialCost,
      labourCost,
      subtotal,
      gstAmount,
      grandTotal,
      rateSqM:
        billableArea > 0
          ? grandTotal / billableArea
          : 0,
      rateSqFt:
        billableArea > 0
          ? grandTotal /
            (billableArea * 10.7639)
          : 0
    };
  }, [
    location,
    system,
    selectedBrand,
    useDirectArea,
    directArea,
    length,
    width,
    height,
    numberOfUnits,
    deductionArea,
    wastage,
    coats,
    coverage,
    treatmentThickness,
    rollWidth,
    rollLength,
    lapEfficiency,
    manualLabourRate,
    gst,
    masterRates
  ]);

  const exportCsv = () => {
    const rows = [
      ["BuildMitra Waterproofing Estimate"],
      ["Location", location],
      ["Waterproofing System", system],
      ["Make / Brand", selectedBrand],
      ["Treatment Area (m²)", fmt(result.billableArea)],
      [
        "Labour Application Rate / m²",
        result.appliedLabourRate
          ? fmt(result.appliedLabourRate)
          : "Rate Not Configured"
      ],
      [],
      [
        "Item",
        "Make / Brand",
        "Quantity",
        "Unit",
        "Rate",
        "Amount"
      ],
      ...result.rows.map((row) => [
        row.item,
        row.make,
        fmt(row.quantity),
        row.unit,
        row.rate
          ? fmt(row.rate)
          : "Rate Not Configured",
        row.rate
          ? fmt(row.quantity * row.rate)
          : ""
      ]),
      [],
      ["Material Cost", fmt(result.materialCost)],
      ["Labour Cost", fmt(result.labourCost)],
      ["Subtotal", fmt(result.subtotal)],
      ["GST", fmt(result.gstAmount)],
      ["Grand Total", fmt(result.grandTotal)]
    ];

    const csv = rows
      .map((row) =>
        row
          .map(
            (cell) =>
              `"${String(cell ?? "").replace(
                /"/g,
                '""'
              )}"`
          )
          .join(",")
      )
      .join("\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download =
      "BuildMitra_Waterproofing_Estimate.csv";

    link.click();
    URL.revokeObjectURL(url);
  };

  const shareEstimate = async () => {
    const text = [
      "BuildMitra Waterproofing Estimate",
      `Location: ${location}`,
      `System: ${system}`,
      `Brand: ${selectedBrand}`,
      `Treatment Area: ${fmt(result.billableArea)} m²`,
      `Material Cost: ₹${fmt(result.materialCost)}`,
      `Labour Cost: ₹${fmt(result.labourCost)}`,
      `Grand Total: ₹${fmt(result.grandTotal)}`
    ].join("\n");

    if (navigator.share) {
      await navigator.share({
        title:
          "BuildMitra Waterproofing Estimate",
        text
      });
    } else {
      await navigator.clipboard.writeText(text);
      alert("Estimate copied to clipboard");
    }
  };

  return (
    <main className="bm-wp-page">
      <section className="bm-wp-hero">
        <div>
          <span className="bm-wp-kicker">
            BUILDMITRA CALCULATOR
          </span>

          <h1>Waterproofing Calculator</h1>

          <p>
            Waterproofing material quantity, labour and
            cost estimation for terraces, toilets, tanks,
            basements and wet areas.
          </p>
        </div>

        <div className="bm-wp-rate-status">
          {rateStatus}
        </div>
      </section>

      <section className="bm-wp-panel">
        <div className="bm-wp-section-title">
          <div>
            <span>01</span>
            <h2>Project & Treatment Inputs</h2>
          </div>
        </div>

        <div className="bm-wp-input-grid">
          <label>
            Location / Area Type
            <select
              value={location}
              onChange={(event) =>
                setLocation(event.target.value)
              }
            >
              {locations.map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>

          <label>
            Waterproofing System
            <select
              value={system}
              onChange={(event) =>
                setSystem(event.target.value)
              }
            >
              {systems.map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>

          <label>
            Material Make / Brand
            <select
              value={brand}
              onChange={(event) =>
                setBrand(event.target.value)
              }
            >
              {availableBrands.map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>

          {brand === "Other" && (
            <label>
              Other Make / Brand
              <input
                value={customBrand}
                onChange={(event) =>
                  setCustomBrand(event.target.value)
                }
                placeholder="Enter manufacturer or brand"
              />
            </label>
          )}

          <label className="bm-wp-checkbox">
            <input
              type="checkbox"
              checked={useDirectArea}
              onChange={(event) =>
                setUseDirectArea(
                  event.target.checked
                )
              }
            />
            Enter treatment area directly
          </label>

          {useDirectArea ? (
            <label>
              Direct Area (m²)
              <input
                type="number"
                value={directArea}
                onChange={(event) =>
                  setDirectArea(n(event.target.value))
                }
              />
            </label>
          ) : (
            <>
              <label>
                Length (m)
                <input
                  type="number"
                  value={length}
                  onChange={(event) =>
                    setLength(n(event.target.value))
                  }
                />
              </label>

              <label>
                Width (m)
                <input
                  type="number"
                  value={width}
                  onChange={(event) =>
                    setWidth(n(event.target.value))
                  }
                />
              </label>

              <label>
                Height / Depth (m)
                <input
                  type="number"
                  value={height}
                  onChange={(event) =>
                    setHeight(n(event.target.value))
                  }
                />
              </label>
            </>
          )}

          <label>
            Number of Units
            <input
              type="number"
              min="1"
              value={numberOfUnits}
              onChange={(event) =>
                setNumberOfUnits(
                  n(event.target.value)
                )
              }
            />
          </label>

          <label>
            Deduction Area (m²)
            <input
              type="number"
              value={deductionArea}
              onChange={(event) =>
                setDeductionArea(
                  n(event.target.value)
                )
              }
            />
          </label>

          <label>
            Wastage (%)
            <input
              type="number"
              value={wastage}
              onChange={(event) =>
                setWastage(n(event.target.value))
              }
            />
          </label>

          <label>
            Number of Coats
            <input
              type="number"
              min="1"
              value={coats}
              onChange={(event) =>
                setCoats(n(event.target.value))
              }
            />
          </label>

          <label>
            Coverage (m²/kg or litre)
            <input
              type="number"
              step="0.1"
              value={coverage}
              onChange={(event) =>
                setCoverage(n(event.target.value))
              }
            />
          </label>

          <label>
            Brick Bat / Cinder Thickness (mm)
            <input
              type="number"
              value={treatmentThickness}
              onChange={(event) =>
                setTreatmentThickness(
                  n(event.target.value)
                )
              }
            />
          </label>

          <label>
            Membrane Roll Width (m)
            <input
              type="number"
              step="0.1"
              value={rollWidth}
              onChange={(event) =>
                setRollWidth(n(event.target.value))
              }
            />
          </label>

          <label>
            Membrane Roll Length (m)
            <input
              type="number"
              value={rollLength}
              onChange={(event) =>
                setRollLength(n(event.target.value))
              }
            />
          </label>

          <label>
            Membrane Lap Efficiency (%)
            <input
              type="number"
              value={lapEfficiency}
              onChange={(event) =>
                setLapEfficiency(
                  n(event.target.value)
                )
              }
            />
          </label>

          <label>
            Manual Labour Rate (₹/m²)
            <input
              type="number"
              value={manualLabourRate}
              disabled={result.adminLabourRate > 0}
              onChange={(event) =>
                setManualLabourRate(
                  n(event.target.value)
                )
              }
              placeholder={
                result.adminLabourRate
                  ? "Fetched from Admin Master"
                  : "Enter labour application rate"
              }
            />

            <small>
              {result.adminLabourRate
                ? `Admin labour rate: ₹${fmt(
                    result.adminLabourRate
                  )}/m²`
                : "Used only when Admin Master labour rate is unavailable"}
            </small>
          </label>

          <label>
            GST (%)
            <input
              type="number"
              value={gst}
              onChange={(event) =>
                setGst(n(event.target.value))
              }
            />
          </label>
        </div>
      </section>

      <section className="bm-wp-results">
        <article>
          <span>Gross Area</span>
          <strong>{fmt(result.grossArea)} m²</strong>
        </article>

        <article>
          <span>Net Area</span>
          <strong>{fmt(result.netArea)} m²</strong>
        </article>

        <article>
          <span>Billable Area</span>
          <strong>{fmt(result.billableArea)} m²</strong>
        </article>

        <article>
          <span>Primer Quantity</span>
          <strong>{fmt(result.primerQty)} L</strong>
        </article>

        <article>
          <span>Coating Quantity</span>
          <strong>{fmt(result.coatingQty)} KG/L</strong>
        </article>

        <article>
          <span>Membrane Rolls</span>
          <strong>{result.membraneRolls}</strong>
        </article>

        <article>
          <span>Labour Rate</span>
          <strong>
            {result.appliedLabourRate
              ? `₹${fmt(
                  result.appliedLabourRate
                )}/m²`
              : "Not Configured"}
          </strong>
        </article>

        <article className="bm-wp-highlight">
          <span>Grand Total</span>
          <strong>
            ₹{fmt(result.grandTotal)}
          </strong>
        </article>
      </section>

      <section className="bm-wp-panel">
        <div className="bm-wp-section-title">
          <div>
            <span>02</span>
            <h2>Material Estimate</h2>
          </div>
        </div>

        <div className="bm-wp-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Material</th>
                <th>Make / Brand</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Rate</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              {result.rows.map((row) => (
                <tr key={row.key}>
                  <td>{row.item}</td>
                  <td>{row.make}</td>
                  <td>{fmt(row.quantity)}</td>
                  <td>{row.unit}</td>
                  <td>
                    {row.rate
                      ? `₹${fmt(row.rate)}`
                      : "Rate Not Configured"}
                  </td>
                  <td>
                    {row.rate
                      ? `₹${fmt(
                          row.quantity * row.rate
                        )}`
                      : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section className="bm-wp-cost-grid">
        <article>
          <span>Material Cost</span>
          <strong>
            ₹{fmt(result.materialCost)}
          </strong>
        </article>

        <article>
          <span>Labour Cost</span>
          <strong>
            {result.appliedLabourRate
              ? `₹${fmt(result.labourCost)}`
              : "Rate Not Configured"}
          </strong>
        </article>

        <article>
          <span>Subtotal</span>
          <strong>₹{fmt(result.subtotal)}</strong>
        </article>

        <article>
          <span>GST</span>
          <strong>₹{fmt(result.gstAmount)}</strong>
        </article>

        <article>
          <span>Rate / m²</span>
          <strong>₹{fmt(result.rateSqM)}</strong>
        </article>

        <article>
          <span>Rate / sq.ft</span>
          <strong>₹{fmt(result.rateSqFt)}</strong>
        </article>

        <article className="bm-wp-grand-card">
          <span>Grand Total</span>
          <strong>
            ₹{fmt(result.grandTotal)}
          </strong>
        </article>
      </section>

      <section className="bm-wp-panel">
        <div className="bm-wp-section-title">
          <div>
            <span>03</span>
            <h2>Application Guidance</h2>
          </div>
        </div>

        <ol className="bm-wp-guidance">
          <li>
            Clean and prepare the substrate before
            waterproofing.
          </li>
          <li>
            Repair cracks, joints, corners and pipe
            penetrations.
          </li>
          <li>
            Apply primer where required by the selected
            system.
          </li>
          <li>
            Apply the selected product to the recommended
            coverage and thickness.
          </li>
          <li>
            Provide protective screed or plaster where
            required.
          </li>
          <li>
            Conduct ponding/leakage testing before finishing.
          </li>
        </ol>

        <div className="bm-wp-note">
          Quantities and costs are indicative. Verify
          manufacturer coverage, site conditions, substrate
          preparation and application procedure before
          execution.
