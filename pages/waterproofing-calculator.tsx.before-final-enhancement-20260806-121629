import React, { useEffect, useMemo, useState } from "react";

const API_BASE =
  process.env.NEXT_PUBLIC_API_URL ||
  process.env.NEXT_PUBLIC_API_BASE ||
  "http://localhost:5000";

type RateRow = {
  name: string;
  rate: number;
  unit: string;
};

const locations = [
  "Terrace / Roof",
  "Toilet / Bathroom",
  "Balcony",
  "Sunken Slab",
  "Underground Water Tank",
  "Overhead Water Tank",
  "Basement",
  "Retaining Wall",
  "External Wall",
  "Kitchen / Wet Area",
  "Swimming Pool",
  "Damp Proof Course"
];

const systems = [
  "Conventional Brick Bat Coba",
  "Cinder Filling Waterproof Treatment",
  "Polymer Modified Cementitious Coating",
  "Two Component Cementitious Waterproofing",
  "APP / SBS Bituminous Membrane",
  "Self Adhesive Membrane",
  "PU Liquid Membrane",
  "Acrylic Waterproof Coating",
  "Silicone / Elastomeric Coating",
  "Crystalline Waterproofing",
  "Epoxy Waterproof Coating",
  "Damp Proof Coating"
];

const toNumber = (value: unknown) => {
  const number = Number(value);
  return Number.isFinite(number) ? number : 0;
};

const format = (value: number, digits = 2) =>
  new Intl.NumberFormat("en-IN", {
    maximumFractionDigits: digits,
    minimumFractionDigits: digits
  }).format(value || 0);

function normalizeRateRows(payload: any): RateRow[] {
  const rows =
    payload?.materials ||
    payload?.data ||
    payload?.items ||
    payload ||
    [];

  if (!Array.isArray(rows)) return [];

  return rows.map((row: any) => ({
    name: String(
      row.itemName ||
      row.product_name ||
      row.productName ||
      row.materialName ||
      row.name ||
      ""
    ).toLowerCase(),
    rate: toNumber(
      row.rate ??
      row.price ??
      row.unitRate ??
      row.materialRate ??
      row.sellingPrice
    ),
    unit: String(row.unit || row.uom || "")
  }));
}

export default function WaterproofingCalculator() {
  const [location, setLocation] = useState("Terrace / Roof");
  const [system, setSystem] = useState(
    "Polymer Modified Cementitious Coating"
  );

  const [useDirectArea, setUseDirectArea] = useState(false);
  const [directArea, setDirectArea] = useState(100);
  const [length, setLength] = useState(10);
  const [width, setWidth] = useState(10);
  const [height, setHeight] = useState(0);
  const [units, setUnits] = useState(1);
  const [deduction, setDeduction] = useState(0);
  const [wastage, setWastage] = useState(5);

  const [coats, setCoats] = useState(2);
  const [coverage, setCoverage] = useState(1.5);
  const [thickness, setThickness] = useState(75);
  const [rollWidth, setRollWidth] = useState(1);
  const [rollLength, setRollLength] = useState(10);
  const [lapEfficiency, setLapEfficiency] = useState(85);

  const [gst, setGst] = useState(18);
  const [rates, setRates] = useState<RateRow[]>([]);
  const [rateStatus, setRateStatus] = useState("");

  useEffect(() => {
    const loadRates = async () => {
      const endpoints = [
        `${API_BASE}/api/master/materials`
      ];

      for (const endpoint of endpoints) {
        try {
          const response = await fetch(endpoint);
          if (!response.ok) continue;

          const payload = await response.json();
          const rows = normalizeRateRows(payload);

          if (rows.length) {
            setRates(rows);
            setRateStatus(`${rows.length} Admin Master rates loaded`);
            return;
          }
        } catch {}
      }

      setRateStatus("Admin Master rates unavailable");
    };

    loadRates();
  }, []);

  const findRate = (...terms: string[]) => {
    const normalized = terms.map((term) => term.toLowerCase());

    const exact = rates.find((row) =>
      normalized.every((term) => row.name.includes(term))
    );

    if (exact?.rate) return exact.rate;

    const partial = rates.find((row) =>
      normalized.some((term) => row.name.includes(term))
    );

    return partial?.rate || 0;
  };

  const result = useMemo(() => {
    const qtyUnits = Math.max(1, toNumber(units));

    let grossArea = useDirectArea
      ? toNumber(directArea)
      : toNumber(length) * toNumber(width);

    const isEnclosed =
      /tank|basement|pool/i.test(location) &&
      toNumber(height) > 0;

    if (isEnclosed && !useDirectArea) {
      const floorArea = toNumber(length) * toNumber(width);
      const wallArea =
        2 *
        (toNumber(length) + toNumber(width)) *
        toNumber(height);

      grossArea = floorArea + wallArea;
    }

    grossArea *= qtyUnits;

    const netArea = Math.max(0, grossArea - toNumber(deduction));
    const billableArea =
      netArea * (1 + Math.max(0, toNumber(wastage)) / 100);

    const systemLower = system.toLowerCase();

    const isMembrane = /membrane|app|sbs/.test(systemLower);
    const isBrickBat = /brick bat|cinder/.test(systemLower);
    const isLiquid =
      !isMembrane &&
      !isBrickBat;

    const primerQty = billableArea / 8;

    const coatingQty = isLiquid
      ? (billableArea * Math.max(1, toNumber(coats))) /
        Math.max(0.01, toNumber(coverage))
      : 0;

    const effectiveRollArea =
      toNumber(rollWidth) *
      toNumber(rollLength) *
      (Math.max(1, toNumber(lapEfficiency)) / 100);

    const membraneRolls = isMembrane
      ? Math.ceil(billableArea / Math.max(0.01, effectiveRollArea))
      : 0;

    const fillVolume = isBrickBat
      ? billableArea * (toNumber(thickness) / 1000)
      : 0;

    const cementKg = isBrickBat ? fillVolume * 360 : 0;
    const cementBags = cementKg / 50;
    const sandM3 = isBrickBat ? fillVolume * 0.75 : 0;
    const brickBatM3 = isBrickBat ? fillVolume * 0.8 : 0;
    const waterproofCompoundKg = isBrickBat
      ? cementKg * 0.02
      : 0;

    const materialRows = [
      {
        key: "primer",
        item: "Waterproofing Primer",
        quantity: primerQty,
        unit: "L",
        rate: findRate("waterproof", "primer")
      },
      {
        key: "coating",
        item: system,
        quantity: coatingQty,
        unit: "KG/L",
        rate:
          findRate(...systemLower.split(" ").slice(0, 2)) ||
          findRate("waterproof")
      },
      {
        key: "membrane",
        item: system,
        quantity: membraneRolls,
        unit: "ROLL",
        rate:
          findRate("membrane") ||
          findRate("app") ||
          findRate("sbs")
      },
      {
        key: "cement",
        item: "Cement",
        quantity: cementBags,
        unit: "BAG",
        rate: findRate("cement")
      },
      {
        key: "sand",
        item: "Sand",
        quantity: sandM3,
        unit: "M³",
        rate: findRate("sand")
      },
      {
        key: "brickbat",
        item: /cinder/i.test(system)
          ? "Cinder Filling"
          : "Brick Bats",
        quantity: brickBatM3,
        unit: "M³",
        rate: /cinder/i.test(system)
          ? findRate("cinder")
          : findRate("brick")
      },
      {
        key: "compound",
        item: "Waterproofing Compound",
        quantity: waterproofCompoundKg,
        unit: "KG",
        rate: findRate("waterproof", "compound")
      }
    ].filter((row) => row.quantity > 0.001);

    const labourRate =
      findRate("waterproof", "labour") ||
      findRate("application", "labour") ||
      findRate("labour");

    const materialCost = materialRows.reduce(
      (total, row) => total + row.quantity * row.rate,
      0
    );

    const labourCost = billableArea * labourRate;
    const subtotal = materialCost + labourCost;
    const gstAmount = subtotal * (Math.max(0, toNumber(gst)) / 100);
    const grandTotal = subtotal + gstAmount;

    return {
      grossArea,
      netArea,
      billableArea,
      primerQty,
      coatingQty,
      membraneRolls,
      fillVolume,
      cementBags,
      sandM3,
      brickBatM3,
      waterproofCompoundKg,
      labourRate,
      materialRows,
      materialCost,
      labourCost,
      subtotal,
      gstAmount,
      grandTotal,
      ratePerSqM:
        billableArea > 0 ? grandTotal / billableArea : 0,
      ratePerSqFt:
        billableArea > 0 ? grandTotal / (billableArea * 10.7639) : 0
    };
  }, [
    location,
    system,
    useDirectArea,
    directArea,
    length,
    width,
    height,
    units,
    deduction,
    wastage,
    coats,
    coverage,
    thickness,
    rollWidth,
    rollLength,
    lapEfficiency,
    gst,
    rates
  ]);

  const exportCsv = () => {
    const rows = [
      ["BuildMitra Waterproofing Calculator"],
      ["Location", location],
      ["System", system],
      ["Treatment Area (m²)", format(result.billableArea)],
      [],
      ["Item", "Quantity", "Unit", "Rate", "Amount"],
      ...result.materialRows.map((row) => [
        row.item,
        format(row.quantity),
        row.unit,
        row.rate || "Rate Not Configured",
        row.rate ? format(row.quantity * row.rate) : ""
      ]),
      [],
      ["Material Cost", format(result.materialCost)],
      ["Labour Cost", format(result.labourCost)],
      ["GST", format(result.gstAmount)],
      ["Grand Total", format(result.grandTotal)]
    ];

    const csv = rows
      .map((row) =>
        row
          .map((cell) =>
            `"${String(cell ?? "").replace(/"/g, '""')}"`
          )
          .join(",")
      )
      .join("\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "BuildMitra_Waterproofing_Estimate.csv";
    link.click();

    URL.revokeObjectURL(url);
  };

  const shareReport = async () => {
    const text =
      `BuildMitra Waterproofing Estimate\n` +
      `${location}\n${system}\n` +
      `Area: ${format(result.billableArea)} m²\n` +
      `Estimated Total: ₹${format(result.grandTotal)}`;

    if (navigator.share) {
      await navigator.share({
        title: "BuildMitra Waterproofing Estimate",
        text
      });
    } else {
      await navigator.clipboard.writeText(text);
      alert("Estimate copied to clipboard");
    }
  };

  return (
    <div className="wp-page">
      <header className="wp-header">
        <div>
          <h1>BuildMitra Waterproofing Calculator</h1>
          <p>
            Terrace, toilets, tanks, basements, walls and wet-area
            waterproofing quantity and cost estimation.
          </p>
        </div>

        <span className="wp-rate-status">{rateStatus}</span>
      </header>

      <section className="wp-panel">
        <h2>Project Inputs</h2>

        <div className="wp-grid">
          <label>
            Waterproofing Location
            <select
              value={location}
              onChange={(event) => setLocation(event.target.value)}
            >
              {locations.map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>

          <label>
            Waterproofing System
            <select
              value={system}
              onChange={(event) => setSystem(event.target.value)}
            >
              {systems.map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>

          <label className="wp-check">
            <input
              type="checkbox"
              checked={useDirectArea}
              onChange={(event) =>
                setUseDirectArea(event.target.checked)
              }
            />
            Enter area directly
          </label>

          {useDirectArea ? (
            <label>
              Direct Area (m²)
              <input
                type="number"
                value={directArea}
                onChange={(event) =>
                  setDirectArea(toNumber(event.target.value))
                }
              />
            </label>
          ) : (
            <>
              <label>
                Length (m)
                <input
                  type="number"
                  value={length}
                  onChange={(event) =>
                    setLength(toNumber(event.target.value))
                  }
                />
              </label>

              <label>
                Width (m)
                <input
                  type="number"
                  value={width}
                  onChange={(event) =>
                    setWidth(toNumber(event.target.value))
                  }
                />
              </label>

              <label>
                Height / Depth (m)
                <input
                  type="number"
                  value={height}
                  onChange={(event) =>
                    setHeight(toNumber(event.target.value))
                  }
                />
              </label>
            </>
          )}

          <label>
            Number of Units
            <input
              type="number"
              value={units}
              onChange={(event) =>
                setUnits(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Deduction Area (m²)
            <input
              type="number"
              value={deduction}
              onChange={(event) =>
                setDeduction(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Wastage (%)
            <input
              type="number"
              value={wastage}
              onChange={(event) =>
                setWastage(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Number of Coats
            <input
              type="number"
              value={coats}
              onChange={(event) =>
                setCoats(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Coverage (m²/kg or litre)
            <input
              type="number"
              step="0.1"
              value={coverage}
              onChange={(event) =>
                setCoverage(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Brick Bat / Cinder Thickness (mm)
            <input
              type="number"
              value={thickness}
              onChange={(event) =>
                setThickness(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Membrane Roll Width (m)
            <input
              type="number"
              step="0.1"
              value={rollWidth}
              onChange={(event) =>
                setRollWidth(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Membrane Roll Length (m)
            <input
              type="number"
              value={rollLength}
              onChange={(event) =>
                setRollLength(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            Lap Efficiency (%)
            <input
              type="number"
              value={lapEfficiency}
              onChange={(event) =>
                setLapEfficiency(toNumber(event.target.value))
              }
            />
          </label>

          <label>
            GST (%)
            <input
              type="number"
              value={gst}
              onChange={(event) =>
                setGst(toNumber(event.target.value))
              }
            />
          </label>
        </div>
      </section>

      <section className="wp-result-grid">
        <article>
          <span>Gross Area</span>
          <strong>{format(result.grossArea)} m²</strong>
        </article>

        <article>
          <span>Net Area</span>
          <strong>{format(result.netArea)} m²</strong>
        </article>

        <article>
          <span>Billable Area</span>
          <strong>{format(result.billableArea)} m²</strong>
        </article>

        <article>
          <span>Primer</span>
          <strong>{format(result.primerQty)} L</strong>
        </article>

        <article>
          <span>Coating Quantity</span>
          <strong>{format(result.coatingQty)} KG/L</strong>
        </article>

        <article>
          <span>Membrane Rolls</span>
          <strong>{result.membraneRolls}</strong>
        </article>

        <article>
          <span>Brick Bat / Cinder Volume</span>
          <strong>{format(result.fillVolume)} m³</strong>
        </article>

        <article>
          <span>Estimated Cost</span>
          <strong>₹{format(result.grandTotal)}</strong>
        </article>
      </section>

      <section className="wp-panel">
        <h2>Material & Cost Estimate</h2>

        <div className="wp-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Rate</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              {result.materialRows.map((row) => (
                <tr key={row.key}>
                  <td>{row.item}</td>
                  <td>{format(row.quantity)}</td>
                  <td>{row.unit}</td>
                  <td>
                    {row.rate
                      ? `₹${format(row.rate)}`
                      : "Rate Not Configured"}
                  </td>
                  <td>
                    {row.rate
                      ? `₹${format(row.quantity * row.rate)}`
                      : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div className="wp-summary">
          <div>
            <span>Material Cost</span>
            <strong>₹{format(result.materialCost)}</strong>
          </div>

          <div>
            <span>Labour Cost</span>
            <strong>
              {result.labourRate
                ? `₹${format(result.labourCost)}`
                : "Rate Not Configured"}
            </strong>
          </div>

          <div>
            <span>GST</span>
            <strong>₹{format(result.gstAmount)}</strong>
          </div>

          <div className="wp-grand">
            <span>Grand Total</span>
            <strong>₹{format(result.grandTotal)}</strong>
          </div>

          <div>
            <span>Rate / m²</span>
            <strong>₹{format(result.ratePerSqM)}</strong>
          </div>

          <div>
            <span>Rate / sq.ft</span>
            <strong>₹{format(result.ratePerSqFt)}</strong>
          </div>
        </div>
      </section>

      <section className="wp-panel">
        <h2>Application Guidance</h2>

        <ol>
          <li>Clean the substrate and remove loose material.</li>
          <li>Repair cracks, joints and pipe penetrations.</li>
          <li>Apply primer where required by the selected system.</li>
          <li>
            Apply the selected waterproofing system to the approved
            thickness and coverage.
          </li>
          <li>
            Provide protective screed/plaster where the membrane may
            be damaged.
          </li>
          <li>
            Conduct a ponding or leakage test before finishing work.
          </li>
        </ol>

        <p className="wp-note">
          Quantities are indicative and must be verified against the
          manufacturer's technical data sheet and actual site
          conditions.
        </p>
      </section>

      <div className="wp-actions">
        <button type="button" onClick={() => window.print()}>
          Print / Download PDF
        </button>

        <button type="button" onClick={exportCsv}>
          Export CSV
        </button>

        <button type="button" onClick={shareReport}>
          Share Estimate
        </button>
      </div>

      <style jsx>{`
