export default function LabourNet() {
  const [workers, setWorkers] = useState<Worker[]>([]);
  const [search, setSearch] = useState("");
  const [status, setStatus] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [selected, setSelected] = useState<Worker | null>(null);

  async function loadWorkers() {
    try {
      setLoading(true);
      setError("");

      const response = await fetch(`${API_BASE}/api/labour-net`);
      const body = await response.json();

      if (!response.ok) {
        throw new Error(body.message || `Labour API failed: ${response.status}`);
      }

      const rows = Array.isArray(body.labours)
        ? body.labours
        : Array.isArray(body.workers)
        ? body.workers
        : [];

      const validRows = rows.filter((r: any) => r.name && r.name !== 'Worker A');
      if (validRows.length >= 10) {
        setWorkers(validRows);
      } else {
        setWorkers([]);
      }
    } catch (err: any) {
      console.log("Labour Net API fallback active:", err?.message);
      setWorkers([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadWorkers();
  }, []);

  const filtered = useMemo(() => {
    const query = search.trim().toLowerCase();

    return workers.filter((worker) => {
      const combined = [
        worker.name,
        worker.workerCode,
        worker.skill,
        worker.mobile,
        worker.location,
        worker.status,
        worker.uploaderName
      ]
        .map((item) => String(item || ""))
        .join(" ")
        .toLowerCase();

      const searchMatch = !query || combined.includes(query);
      const statusMatch =
        !status ||
        String(worker.status || "").toLowerCase() === status.toLowerCase();

      return searchMatch && statusMatch;
    });
  }, [workers, search, status]);

  async function openWhatsApp(worker: Worker) {
    let phone = digits(worker.mobile || worker.uploaderMobile);

    if (!phone) {
      alert("Worker or provider contact number is not available.");
      return;
    }

    if (phone.length === 10) phone = `91${phone}`;

    /*
     * Save Labour Net enquiry through BuildMitra's existing
     * MongoDB enquiry architecture before opening WhatsApp.
     *
     * Public visitors can still contact through WhatsApp.
     * Logged-in BuildMitra users additionally get a persisted enquiry.
     */
    try {
      let currentUser: any = {};

      if (typeof window !== "undefined") {
        const possibleKeys = [
          "currentUser",
          "loggedInUser",
          "user"
        ];

        for (const key of possibleKeys) {
          const stored = localStorage.getItem(key);

          if (stored) {
            try {
              const parsed = JSON.parse(stored);

              if (parsed && typeof parsed === "object") {
                currentUser = parsed;
                break;
              }
            } catch {}
          }
        }
      }

      const buyerName =
        currentUser.name ||
        currentUser.fullName ||
        currentUser.userName ||
        "";

      const buyerPhone =
        currentUser.phone ||
        currentUser.mobile ||
        currentUser.mobileNumber ||
        "";

      const buyerUserCode =
        currentUser.userCode ||
        currentUser.buyerUserCode ||
        "";

      const labour: any = worker;

      const providerUserCode =
        labour.providerUserCode ||
        labour.uploaderUserCode ||
        labour.userCode ||
        labour.providerCode ||
        labour.workerCode ||
        "";

      const providerName =
        worker.uploaderName ||
        worker.name ||
        "Labour Provider";

      const providerPhone =
        worker.uploaderMobile ||
        worker.mobile ||
        "";

      /*
       * Persist only when valid buyer identity exists.
       * Do not create incomplete/anonymous database records.
       */
      if (
        buyerName &&
        digits(buyerPhone).length >= 10 &&
        providerUserCode
      ) {
        const response = await fetch(`${API_BASE}/api/enquiry`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            enquiryCategory: "general",

            buyerUserCode,
            buyerName,
            buyerPhone,

            providerUserCode,
            providerRole: "labour",
            providerName,
            providerPhone,

            itemType: "labour",
            itemName:
              worker.skill ||
              worker.name ||
              "Labour Requirement",

            listingCode:
              worker.workerCode ||
              String(worker._id || ""),

            quantity: 1,
            unit: worker.rateUnit || "day",

            location: worker.location || "",

            specification:
              `Labour Net enquiry - ${worker.skill || "Labour"}${
                worker.experience
                  ? `, Experience: ${worker.experience}`
                  : ""
              }`,

            message:
              "Enquiry created from BuildMitra Labour Net"
          })
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || result?.success === false) {
          console.error(
            "Labour enquiry save failed:",
            result?.message || response.status
          );
        }
      }
    } catch (error) {
      /*
       * Persistence failure must never break the existing
       * user contact action.
       */
      console.error("Labour enquiry persistence error:", error);
    }

    const message = encodeURIComponent(
      `Hello ${text(worker.name, "Labour Provider")},\n\n` +
      `I found your profile on BuildMitra Labour Net.\n\n` +
      `Skill: ${text(worker.skill)}\n` +
      `Daily wage: ${
        worker.dailyWage
          ? `₹${worker.dailyWage}/${worker.rateUnit || "day"}`
          : "Please share"
      }\n` +
      `Status: ${text(worker.status)}\n\n` +
      `Please let me know if your team is available.`
    );

    window.open(
      `https://wa.me/${phone}?text=${message}`,
      "_blank"
    );
  }
  return (
    <>
      <Head>
        <title>Labour Net | BuildMitra</title>
        <meta
          name="description"
          content="Find skilled construction workers, labour teams and labour contractors with clear rates."
        />
      </Head>

      <main className="page">
        <section className="hero">
          <div>
            <span>BUILDMITRA WORKFORCE</span>
            <h1>👷 Labour Net</h1>
            <p>
              Find and engage skilled workers, labour teams and labour contractors
              with clear rates, stay and transport details.
            </p>
          </div>

          <div style={{ display: "flex", gap: "10px", flexWrap: "wrap", alignItems: "center" }}>
            <button onClick={() => window.location.href = "/labour-attendance"} style={{ backgroundColor: "#16a34a", color: "#fff", border: 0, padding: "10px 18px", borderRadius: "8px", fontWeight: "bold", cursor: "pointer" }}>
              📍 50m Geofence Attendance
            </button>
            <button onClick={loadWorkers} disabled={loading}>
              {loading ? "Refreshing..." : "Refresh Directory"}
            </button>
          </div>
        </section>

        <section className="filters">
          <input
            type="text"
            placeholder="Search worker, skill, location, mobile or code"
            value={search}
            onChange={(event) => setSearch(event.target.value)}
          />

          <select
            value={status}
            onChange={(event) => setStatus(event.target.value)}
          >
            <option value="">All status</option>
            <option value="Available">Available</option>
            <option value="Deployed">Deployed</option>
            <option value="Busy">Busy</option>
          </select>
        </section>

        <div className="count">
          Showing {filtered.length} of {workers.length} workers
        </div>

        {error && <div className="message error">{error}</div>}

        {loading ? (
          <div className="message">Loading labour directory...</div>
        ) : filtered.length === 0 ? (
          <div className="message">No labour records match your search.</div>
        ) : (
          <section className="grid">
            {filtered.map((worker, index) => {
              const contact = worker.mobile || worker.uploaderMobile;

              return (
                <article
                  key={worker._id || worker.workerCode || index}
                  className="card"
                >
                  <div className="cardTop">
                    <div>
                      <small>{text(worker.workerCode, `LAB-${index + 1}`)}</small>
                      <h2>{text(worker.name)}</h2>
                      <strong className="skill">
                        {text(worker.skill, "General Labour")}
                      </strong>
                    </div>

                    <div className="photo">
                      {worker.photo ? (
                        <img src={worker.photo} alt={text(worker.name)} />
                      ) : (
                        <span>👷</span>
                      )}
                    </div>
                  </div>

                  <div className="status">
                    {text(worker.status, "Available")}
                  </div>

                  <div className="costBox">
                    <span>Daily rate</span>
                    <strong>
                      {worker.dailyWage
                        ? `₹${worker.dailyWage}/${worker.rateUnit || "day"}`
                        : "Contact for rate"}
                    </strong>
                  </div>

                  <div className="details">
                    <div>
                      <label>Location</label>
                      <strong>{text(worker.location)}</strong>
                    </div>

                    <div>
                      <label>Experience</label>
                      <strong>
                        {worker.experience
                          ? `${worker.experience}`
                          : "Not provided"}
                      </strong>
                    </div>

                    <div>
                      <label>Team size</label>
                      <strong>{text(worker.teamSize, "Individual")}</strong>
                    </div>

                    <div>
                      <label>Working hours</label>
                      <strong>{text(worker.workingHours, "8 hrs/day")}</strong>
                    </div>
                  </div>

                  <h3>Stay & Transport</h3>

                  <div className="facilityGrid">
                    <div>
                      <span>Staying</span>
                      <strong>
                        {yes(worker.stayingAvailable)
                          ? worker.stayingCost
                            ? `₹${worker.stayingCost}`
                            : "Available"
                          : "Not available"}
                      </strong>
                    </div>

                    <div>
                      <span>Food</span>
                      <strong>
                        {yes(worker.foodAvailable)
                          ? worker.foodCost
                            ? `₹${worker.foodCost}`
                            : "Available"
                          : "Not available"}
                      </strong>
                    </div>

                    <div>
                      <span>Conveyance</span>
                      <strong>
                        {yes(worker.conveyanceAvailable)
                          ? worker.conveyanceCost
                            ? `₹${worker.conveyanceCost}`
                            : "Included"
                          : "Not available"}
                      </strong>
                    </div>

                    <div>
                      <span>Pickup / Drop</span>
                      <strong>
                        {yes(worker.pickupDropAvailable)
                          ? worker.pickupDropCost
                            ? `₹${worker.pickupDropCost}`
                            : text(worker.pickupDropDetails, "Available")
                          : "Not available"}
                      </strong>
                    </div>
                  </div>

                  <div className="provider">
                    <span>Uploaded by</span>
                    <strong>{text(worker.uploaderName, worker.name || "Provider")}</strong>
                    <small>{text(contact, "Contact not provided")}</small>
                  </div>

                  <div className="actions">
                    <button onClick={() => setSelected(worker)}>
                      Details
                    </button>

                    {contact ? (
                      <a href={`tel:${contact}`}>Call</a>
                    ) : (
                      <button disabled>Call</button>
                    )}

                    <button onClick={() => openWhatsApp(worker)}>
                      WhatsApp
                    </button>

                    <button onClick={() => openWhatsApp(worker)}>
                      Enquiry
                    </button>
                  </div>
                </article>
              );
            })}
          </section>
        )}
      </main>

      {selected && (
        <div className="overlay" onClick={() => setSelected(null)}>
          <div className="modal" onClick={(event) => event.stopPropagation()}>
            <button className="close" onClick={() => setSelected(null)}>
              ×
            </button>

            <h2>{text(selected.name)}</h2>
            <p>{text(selected.skill)}</p>

            <div className="modalGrid">
              <div><span>Daily wage</span><strong>{selected.dailyWage ? `₹${selected.dailyWage}/${selected.rateUnit || "day"}` : "Not provided"}</strong></div>
              <div><span>Status</span><strong>{text(selected.status)}</strong></div>
              <div><span>Location</span><strong>{text(selected.location)}</strong></div>
              <div><span>Experience</span><strong>{text(selected.experience)}</strong></div>
              <div><span>Mobile</span><strong>{text(selected.mobile)}</strong></div>
              <div><span>Team size</span><strong>{text(selected.teamSize)}</strong></div>
              <div><span>Available from</span><strong>{text(selected.availableFrom)}</strong></div>
              <div><span>Working hours</span><strong>{text(selected.workingHours)}</strong></div>
              <div><span>Overtime rate</span><strong>{text(selected.overtimeRate)}</strong></div>
              <div><span>Staying cost</span><strong>{text(selected.stayingCost)}</strong></div>
              <div><span>Food cost</span><strong>{text(selected.foodCost)}</strong></div>
              <div><span>Conveyance cost</span><strong>{text(selected.conveyanceCost)}</strong></div>
              <div><span>Pickup/drop</span><strong>{text(selected.pickupDropDetails)}</strong></div>
              <div><span>Pickup/drop cost</span><strong>{text(selected.pickupDropCost)}</strong></div>
              <div><span>Provider</span><strong>{text(selected.uploaderName)}</strong></div>
              <div><span>Provider contact</span><strong>{text(selected.uploaderMobile)}</strong></div>
            </div>
          </div>
        </div>
      )}

