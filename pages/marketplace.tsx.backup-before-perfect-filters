import React, { useEffect, useState } from "react";

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000";

export default function Marketplace() {
  const [listings, setListings] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [itemType, setItemType] = useState("material");
  const [location, setLocation] = useState("");

  const loadListings = async () => {
    try {
      setLoading(true);
      const params = new URLSearchParams();
      if (itemType) params.append("itemType", itemType);
      if (location) params.append("location", location);

      const res = await fetch(`${API_BASE}/api/provider/marketplace-listings?${params.toString()}`);
      const data = await res.json();
      setListings(data.listings || []);
    } catch (err) {
      console.error("Marketplace load error:", err);
      setListings([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadListings();
  }, []);

  const cleanPhone = (phone: string) => {
    if (!phone) return "";
    return phone.replace(/\D/g, "").replace(/^91/, "");
  };

  const goToProfile = (item: any) => {
    const code = item.providerUserCode || item.listingCode;
    window.location.href = `/public-profile/${code}`;
  };

  const sendWhatsApp = (item: any) => {
    const phone = cleanPhone(item.providerPhone);
    const msg = `Hello ${item.providerName},

I am interested in your BuildMitra marketplace listing.

Item: ${item.itemName}
Rate: ₹${item.rate} / ${item.unit}
Location: ${item.location}

Please send quotation.`;

    window.open(`https://wa.me/91${phone}?text=${encodeURIComponent(msg)}`, "_blank");
  };

  return (
    <div style={styles.page}>
      <div style={styles.header}>
        <h1 style={styles.title}>🏗️ BuildMitra Marketplace</h1>
        <p style={styles.subtitle}>Find verified materials, services, machines and labour.</p>
      </div>

      <div style={styles.filters}>
        <select value={itemType} onChange={(e) => setItemType(e.target.value)} style={styles.input}>
          <option value="">All Types</option>
          <option value="material">Material</option>
          <option value="service">Service</option>
          <option value="machine">Machine</option>
          <option value="labour">Labour</option>
        </select>

        <input
          value={location}
          onChange={(e) => setLocation(e.target.value)}
          placeholder="Location e.g. Bengaluru"
          style={styles.input}
        />

        <button onClick={loadListings} style={styles.searchBtn}>🔍 Search</button>
      </div>

      {loading ? (
        <div style={styles.emptyCard}>Loading marketplace...</div>
      ) : listings.length === 0 ? (
        <div style={styles.emptyCard}>No approved listings found.</div>
      ) : (
        <div style={styles.grid}>
          {listings.map((item) => (
            <div key={item._id || item.listingCode} style={styles.card}>
              <div style={styles.providerRow}>
                <div style={styles.avatar} onClick={() => goToProfile(item)}>
                  {(item.providerName || "BM").slice(0, 2).toUpperCase()}
                </div>

                <div style={{ flex: 1 }}>
                  <div onClick={() => goToProfile(item)} style={styles.providerName}>
                    {item.providerName || "Verified Provider"}
                  </div>
                  <div style={styles.verified}>✔ Verified Provider</div>
                </div>

                <button onClick={() => goToProfile(item)} style={styles.profileBtn}>
                  View Profile
                </button>
              </div>

              <div style={styles.productRow}>
                <div style={styles.imageBox}>
                  <div style={styles.noImage}>🏗️</div>
                </div>

                <div style={styles.details}>
                  <h2 style={styles.itemName}>{item.itemName}</h2>
                  <div style={styles.smallText}>🏷️ {item.category || item.itemType}</div>
                  <div style={styles.smallText}>📦 {item.brand || "Brand not specified"}</div>
                  <div style={styles.smallText}>📍 {item.location || "-"} {item.pincode ? `- ${item.pincode}` : ""}</div>

                  <div style={styles.priceBox}>
                    ₹{item.rate || "Call"} <span style={styles.unit}>/ {item.unit || "unit"}</span>
                  </div>
                </div>
              </div>

              <div style={styles.actions}>
                <button onClick={() => sendWhatsApp(item)} style={styles.whatsappBtn}>
                  📱 WhatsApp Enquiry
                </button>

                <button
                  onClick={() =>
                    alert(`Item: ${item.itemName}\nSpecification: ${item.specification || "-"}\nGST: ${item.gst || 0}%\nCode: ${item.listingCode}`)
                  }
                  style={styles.detailsBtn}
                >
                  View Details
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

