import React, { useEffect, useMemo, useState } from "react";

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:5000";

const cities = ["", "Bengaluru", "Hyderabad", "Chennai", "Kochi"];
const types = ["", "material", "service", "machine", "labour"];
const categories = ["", "Cement", "Steel", "Sand", "Blocks", "Construction", "Painting", "Excavator", "Concrete Mixer", "Mason", "Helper"];

export default function Marketplace() {
  const [allListings, setAllListings] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  const [search, setSearch] = useState("");
  const [city, setCity] = useState("");
  const [pincode, setPincode] = useState("");
  const [itemType, setItemType] = useState("");
  const [category, setCategory] = useState("");

  const loadListings = async () => {
    try {
      setLoading(true);
      const res = await fetch(`${API_BASE}/api/provider/marketplace-listings`);
      const data = await res.json();
      setAllListings(data.listings || []);
    } catch (err) {
      console.error("Marketplace load error:", err);
      setAllListings([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadListings();
  }, []);

  const filtered = useMemo(() => {
    return allListings.filter((x) => {
      const q = search.toLowerCase();

      const matchesSearch =
        !q ||
        `${x.itemName || ""} ${x.providerName || ""} ${x.brand || ""} ${x.category || ""} ${x.location || ""} ${x.pincode || ""}`
          .toLowerCase()
          .includes(q);

      const matchesCity = !city || (x.location || "").toLowerCase().includes(city.toLowerCase());
      const matchesPincode = !pincode || (x.pincode || "").includes(pincode);
      const matchesType = !itemType || x.itemType === itemType;
      const matchesCategory = !category || x.category === category;

      return matchesSearch && matchesCity && matchesPincode && matchesType && matchesCategory;
    });
  }, [allListings, search, city, pincode, itemType, category]);

  const cleanPhone = (phone: string) => {
    if (!phone) return "";
    return phone.replace(/\D/g, "").replace(/^91/, "");
  };

  const getIcon = (item: any) => {
    const type = (item.itemType || "").toLowerCase();
    const cat = (item.category || "").toLowerCase();

    if (cat.includes("cement")) return "🏗️";
    if (cat.includes("steel")) return "🔩";
    if (cat.includes("sand")) return "🏖️";
    if (cat.includes("block")) return "🧱";
    if (type.includes("machine")) return "🚜";
    if (type.includes("labour")) return "👷";
    if (type.includes("service")) return "🏢";
    return "📦";
  };

  const goToProfile = (item: any) => {
    const code = item.providerUserCode || item.listingCode;
    window.location.href = `/public-profile/${code}`;
  };

  const sendWhatsApp = (item: any) => {
    const phone = cleanPhone(item.providerPhone);
    const msg = `Hello ${item.providerName},

I am interested in your BuildMitra listing.

Item: ${item.itemName}
Rate: ₹${item.rate} / ${item.unit}
Location: ${item.location}
Pincode: ${item.pincode || "-"}

Please send quotation.`;

    window.open(`https://wa.me/91${phone}?text=${encodeURIComponent(msg)}`, "_blank");
  };

  return (
    <div style={styles.page}>
      <div style={styles.header}>
        <h1 style={styles.title}>🏗️ BuildMitra Marketplace</h1>
        <p style={styles.subtitle}>Verified materials, contractors, machines and labour near your project.</p>
      </div>

      <div style={styles.filterBox}>
        <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Search item, provider, brand..." style={styles.input} />

        <select value={city} onChange={(e) => setCity(e.target.value)} style={styles.input}>
          <option value="">All Cities</option>
          {cities.filter(Boolean).map((c) => <option key={c} value={c}>{c}</option>)}
        </select>

        <input value={pincode} onChange={(e) => setPincode(e.target.value)} placeholder="PIN code / area" style={styles.input} />

        <select value={itemType} onChange={(e) => setItemType(e.target.value)} style={styles.input}>
          <option value="">All Types</option>
          <option value="material">Material</option>
          <option value="service">Contractor / Service</option>
          <option value="machine">Machine</option>
          <option value="labour">Labour</option>
        </select>

        <select value={category} onChange={(e) => setCategory(e.target.value)} style={styles.input}>
          <option value="">All Categories</option>
          {categories.filter(Boolean).map((c) => <option key={c} value={c}>{c}</option>)}
        </select>

        <button onClick={() => { setSearch(""); setCity(""); setPincode(""); setItemType(""); setCategory(""); }} style={styles.clearBtn}>
          Clear
        </button>
      </div>

      <div style={styles.count}>
        Showing <b>{filtered.length}</b> approved listings
      </div>

      {loading ? (
        <div style={styles.emptyCard}>Loading marketplace...</div>
      ) : filtered.length === 0 ? (
        <div style={styles.emptyCard}>No matching listings found.</div>
      ) : (
        <div style={styles.grid}>
          {filtered.map((item) => (
            <div key={item._id || item.listingCode} style={styles.card}>
              <div style={styles.providerRow}>
                <div style={styles.avatar} onClick={() => goToProfile(item)}>
                  {(item.providerName || "BM").slice(0, 2).toUpperCase()}
                </div>

                <div style={{ flex: 1 }}>
                  <div onClick={() => goToProfile(item)} style={styles.providerName}>
                    {item.providerName || "Verified Provider"}
                  </div>
                  <div style={styles.verified}>✔ Verified BuildMitra Provider</div>
                </div>

                <button onClick={() => goToProfile(item)} style={styles.profileBtn}>Profile</button>
              </div>

              <div style={styles.productRow}>
                <div style={styles.imageBox}>
  {item.imageUrl ? (
    <img
      src={item.imageUrl}
      alt={item.itemName}
      style={styles.productImage}
    />
  ) : (
    <span>{getIcon(item)}</span>
  )}
</div>

                <div style={styles.details}>
                  <h2 style={styles.itemName}>{item.itemName}</h2>
                  <div style={styles.tagRow}>
                    <span style={styles.tag}>{item.itemType}</span>
                    <span style={styles.tag}>{item.category}</span>
                  </div>
                  <div style={styles.smallText}>📦 {item.brand || "Brand not specified"}</div>
                  <div style={styles.smallText}>📍 {item.location || "-"} {item.pincode ? `- ${item.pincode}` : ""}</div>

                  <div style={styles.priceBox}>
                    ₹{item.rate || "Call"} <span style={styles.unit}>/ {item.unit || "unit"}</span>
                  </div>
                </div>
              </div>

              <div style={styles.actions}>
                <button onClick={() => sendWhatsApp(item)} style={styles.whatsappBtn}>📱 WhatsApp</button>
                <button onClick={() => alert(`Provider: ${item.providerName}\nItem: ${item.itemName}\nSpecification: ${item.specification || "-"}\nGST: ${item.gst || 0}%\nCode: ${item.listingCode}`)} style={styles.detailsBtn}>
                  Details
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

const styles: { [key: string]: React.CSSProperties } = {
  page: { minHeight: "100vh", background: "#f5f7fb", padding: 24, fontFamily: "Arial, sans-serif", color: "#111827" },
  header: { maxWidth: 1250, margin: "0 auto 18px auto" },
  title: { margin: 0, fontSize: 34, fontWeight: 900 },
  subtitle: { marginTop: 8, color: "#6b7280", fontSize: 16 },

  filterBox: {
    maxWidth: 1250,
    margin: "0 auto 14px auto",
    background: "white",
    padding: 16,
    borderRadius: 16,
    display: "grid",
    gridTemplateColumns: "2fr 1fr 1fr 1fr 1fr auto",
    gap: 10,
    boxShadow: "0 3px 12px rgba(0,0,0,0.08)",
  },
  input: { padding: "12px 13px", borderRadius: 10, border: "1px solid #d1d5db", fontSize: 14, background: "white" },
  clearBtn: { padding: "12px 16px", borderRadius: 10, border: "none", background: "#ef4444", color: "white", fontWeight: 800, cursor: "pointer" },
  count: { maxWidth: 1250, margin: "0 auto 16px auto", color: "#374151" },

  grid: { maxWidth: 1250, margin: "0 auto", display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(340px, 1fr))", gap: 18 },
  card: { background: "white", borderRadius: 16, boxShadow: "0 4px 14px rgba(0,0,0,0.08)", overflow: "hidden", border: "1px solid #e5e7eb" },

  providerRow: { display: "flex", alignItems: "center", gap: 12, padding: 16, borderBottom: "1px solid #e5e7eb" },
  avatar: { width: 48, height: 48, borderRadius: "50%", background: "#0f3b82", color: "white", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 900, cursor: "pointer" },
  providerName: { fontSize: 18, fontWeight: 900, cursor: "pointer" },
  verified: { fontSize: 13, color: "#16a34a", marginTop: 3 },
  profileBtn: { padding: "8px 12px", borderRadius: 8, border: "1px solid #2563eb", background: "white", color: "#2563eb", fontWeight: 800, cursor: "pointer" },

  productRow: { display: "flex", gap: 16, padding: 16 },
  imageBox: { width: 115, height: 115, background: "#eef2ff", borderRadius: 14, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 52, flexShrink: 0 },
productImage: {
  width: "100%",
  height: "100%",
  objectFit: "cover",
  borderRadius: 14,
},
  details: { flex: 1 },
  itemName: { margin: "0 0 8px 0", fontSize: 20, lineHeight: 1.25 },
  tagRow: { display: "flex", gap: 6, marginBottom: 8, flexWrap: "wrap" },
  tag: { background: "#eff6ff", color: "#1d4ed8", padding: "4px 8px", borderRadius: 999, fontSize: 12, fontWeight: 800 },
  smallText: { fontSize: 14, color: "#4b5563", marginBottom: 6 },
  priceBox: { display: "inline-block", marginTop: 8, padding: "9px 14px", borderRadius: 10, background: "#ecfdf5", color: "#15803d", fontSize: 24, fontWeight: 900 },
  unit: { fontSize: 15, color: "#374151", fontWeight: 500 },

  actions: { display: "flex", gap: 10, padding: 16, borderTop: "1px solid #e5e7eb" },
  whatsappBtn: { flex: 1, padding: 12, borderRadius: 10, border: "none", background: "#25D366", color: "white", fontWeight: 900, cursor: "pointer" },
  detailsBtn: { padding: "12px 16px", borderRadius: 10, border: "1px solid #d1d5db", background: "white", fontWeight: 800, cursor: "pointer" },

  emptyCard: { maxWidth: 1250, margin: "0 auto", background: "white", padding: 24, borderRadius: 14, boxShadow: "0 2px 10px rgba(0,0,0,0.06)" },
};